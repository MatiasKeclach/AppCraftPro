<%
const t = trabajo || {};

const listaVisitas = typeof visitas !== "undefined" ? visitas : [];
const listaRepuestos = typeof repuestos !== "undefined" ? repuestos : [];
const listaPagos = typeof pagos !== "undefined" ? pagos : [];
const listaGastos = typeof gastos !== "undefined" ? gastos : [];
const listaArchivos = typeof archivos !== "undefined" ? archivos : [];

const estados = {
    pendiente: "Pendiente",
    en_proceso: "En proceso",
    pausado: "Pausado",
    terminado: "Terminado",
    cancelado: "Cancelado"
};

const prioridades = {
    baja: "Baja",
    normal: "Normal",
    alta: "Alta",
    urgente: "Urgente"
};

const dinero = (valor) => Number(valor || 0).toLocaleString("es-AR", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
});

const fecha = (valor) => {
    if (!valor) return "—";
    const d = new Date(valor + (String(valor).length === 10 ? "T12:00:00" : ""));
    return isNaN(d.getTime()) ? valor : d.toLocaleDateString("es-AR");
};

const estadoActual = t.estado || "pendiente";
const totalTrabajo = Number(t.total || 0);
const cobradoTrabajo = Number(t.monto_cobrado || 0);
const saldoTrabajo = totalTrabajo - cobradoTrabajo;
%>

<div class="trabajo-detalle">

    <!-- ENCABEZADO -->

    <div class="top-navigation">
        <a href="/panel/servicios-tecnicos/trabajos">← Volver a trabajos</a>
        <span> / </span>
        <span>Trabajo #<%= t.id %></span>
    </div>

    <header class="detail-header">

        <div>
            <div class="title-line">
                <h1><%= t.titulo || "Trabajo sin título" %></h1>

                <span class="status-badge status-<%= estadoActual %>">
                    <%= estados[estadoActual] || estadoActual %>
                </span>
            </div>

            <div class="header-meta">
                <span>Trabajo #<%= t.id %></span>
                <span>Orden #<%= t.orden_id %></span>
                <span><%= t.rubro || "Sin rubro" %></span>
            </div>
        </div>

        <div class="header-actions">
            <a class="btn-secondary"
               href="/panel/servicios-tecnicos/trabajos/<%= t.id %>/editar">
                ✎ Editar trabajo
            </a>
        </div>

    </header>


    <!-- RESUMEN ECONÓMICO -->

    <section class="metrics-grid">

        <div class="metric-card">
            <div class="metric-label">Mano de obra</div>
            <div class="metric-value">$ <%= dinero(t.mano_obra) %></div>
        </div>

        <div class="metric-card">
            <div class="metric-label">Costo de repuestos</div>
            <div class="metric-value">$ <%= dinero(t.costo_repuestos) %></div>
        </div>

        <div class="metric-card metric-highlight">
            <div class="metric-label">Total del trabajo</div>
            <div class="metric-value">$ <%= dinero(totalTrabajo) %></div>
        </div>

        <div class="metric-card">
            <div class="metric-label">Cobrado</div>
            <div class="metric-value positive">$ <%= dinero(cobradoTrabajo) %></div>
        </div>

        <div class="metric-card">
            <div class="metric-label">Saldo pendiente</div>
            <div class="metric-value <%= saldoTrabajo > 0 ? 'warning' : 'positive' %>">
                $ <%= dinero(saldoTrabajo) %>
            </div>
        </div>

    </section>


    <div class="detail-layout">

        <main class="main-column">

            <!-- DATOS GENERALES -->

            <section class="detail-card">

                <div class="card-heading">
                    <div>
                        <h2>Información del trabajo</h2>
                        <p>Datos generales de la reparación.</p>
                    </div>
                </div>

                <div class="info-grid">

                    <div class="info-item">
                        <span>Rubro</span>
                        <strong><%= t.rubro || "—" %></strong>
                    </div>

                    <div class="info-item">
                        <span>Prioridad</span>
                        <strong>
                            <%= prioridades[t.prioridad] || t.prioridad || "Normal" %>
                        </strong>
                    </div>

                    <div class="info-item">
                        <span>Equipo</span>
                        <strong><%= t.equipo || "—" %></strong>
                    </div>

                    <div class="info-item">
                        <span>Marca</span>
                        <strong><%= t.marca || "—" %></strong>
                    </div>

                    <div class="info-item">
                        <span>Modelo</span>
                        <strong><%= t.modelo || "—" %></strong>
                    </div>

                    <div class="info-item">
                        <span>Fecha de creación</span>
                        <strong><%= fecha(t.created_at) %></strong>
                    </div>

                    <div class="info-item">
                        <span>Inicio</span>
                        <strong><%= fecha(t.fecha_inicio) %></strong>
                    </div>

                    <div class="info-item">
                        <span>Finalización</span>
                        <strong><%= fecha(t.fecha_finalizacion) %></strong>
                    </div>

                </div>

                <% if (t.descripcion) { %>
                    <div class="text-section">
                        <h3>Descripción</h3>
                        <p><%= t.descripcion %></p>
                    </div>
                <% } %>

            </section>


            <!-- DIAGNÓSTICO -->

            <section class="detail-card">

                <div class="card-heading">
                    <div>
                        <h2>Diagnóstico técnico</h2>
                        <p>Problemas detectados y evaluación técnica.</p>
                    </div>
                </div>

                <div class="content-box">
                    <%= t.diagnostico || "Todavía no se registró un diagnóstico." %>
                </div>

            </section>


            <!-- TRABAJO REALIZADO -->

            <section class="detail-card">

                <div class="card-heading">
                    <div>
                        <h2>Trabajo realizado</h2>
                        <p>Detalle de las tareas y soluciones aplicadas.</p>
                    </div>
                </div>

                <div class="content-box">
                    <%= t.trabajo_realizado || "Todavía no se registraron tareas realizadas." %>
                </div>

            </section>


            <!-- VISITAS -->

            <section class="detail-card">

                <div class="card-heading">
                    <div>
                        <h2>Visitas asociadas</h2>
                        <p>Intervenciones relacionadas con este trabajo.</p>
                    </div>
                </div>

                <% if (listaVisitas.length) { %>

                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Visita</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% listaVisitas.forEach(v => { %>
                                    <tr>
                                        <td>
                                            <strong>
                                                Visita #<%= v.numero_visita || v.id %>
                                            </strong>
                                        </td>

                                        <td><%= fecha(v.fecha_programada) %></td>

                                        <td>
                                            <span class="status-badge status-<%= v.estado %>">
                                                <%= estados[v.estado] || v.estado || "—" %>
                                            </span>
                                        </td>

                                        <td>
                                            <a class="table-link"
                                               href="/panel/servicios-tecnicos/visitas/<%= v.id %>">
                                                Ver visita →
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } else { %>

                    <div class="empty-state">
                        <span>📅</span>
                        <strong>Sin visitas vinculadas</strong>
                        <p>Este trabajo todavía no está asociado a ninguna visita.</p>
                    </div>

                <% } %>

                <form
                    action="/panel/servicios-tecnicos/trabajos/<%= t.id %>/vincular-visita"
                    method="POST"
                    class="link-visit-form">

                    <label for="visita_id">Vincular a otra visita</label>

                    <div class="inline-form">
                        <select name="visita_id" id="visita_id" required>
                            <option value="">Seleccionar visita...</option>

                            <% listaVisitasDisponibles.forEach(v => { %>
                                <option value="<%= v.id %>">
                                    Visita #<%= v.numero_visita || v.id %>
                                    — <%= fecha(v.fecha_programada) %>
                                </option>
                            <% }) %>
                        </select>

                        <button type="submit" class="btn-secondary">
                            Vincular
                        </button>
                    </div>

                </form>

            </section>


            <!-- REPUESTOS -->

            <section class="detail-card">

                <div class="card-heading">
                    <div>
                        <h2>Repuestos y materiales</h2>
                        <p>Materiales utilizados en este trabajo.</p>
                    </div>
                </div>

                <% if (listaRepuestos.length) { %>

                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Descripción</th>
                                    <th>Cantidad</th>
                                    <th>Costo unitario</th>
                                    <th>Precio cobrado</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% listaRepuestos.forEach(r => { %>
                                    <tr>
                                        <td><%= r.descripcion || "—" %></td>
                                        <td><%= r.cantidad || 0 %></td>
                                        <td>$ <%= dinero(r.costo_unitario) %></td>
                                        <td>$ <%= dinero(r.precio_cobrado) %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } else { %>

                    <div class="empty-state">
                        <span>📦</span>
                        <strong>No hay repuestos registrados</strong>
                        <p>Los repuestos y materiales de este trabajo aparecerán aquí.</p>
                    </div>

                <% } %>

            </section>


            <!-- PAGOS -->

            <section class="detail-card">

                <div class="card-heading">
                    <div>
                        <h2>Pagos recibidos</h2>
                        <p>Movimientos de cobro asociados al trabajo.</p>
                    </div>
                </div>

                <% if (listaPagos.length) { %>

                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Medio</th>
                                    <th>Referencia</th>
                                    <th>Importe</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% listaPagos.forEach(p => { %>
                                    <tr>
                                        <td><%= fecha(p.fecha_pago) %></td>
                                        <td><%= p.medio_pago || "—" %></td>
                                        <td><%= p.referencia || "—" %></td>
                                        <td class="positive">$ <%= dinero(p.monto) %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } else { %>

                    <div class="empty-state">
                        <span>💳</span>
                        <strong>No hay pagos registrados</strong>
                        <p>Los cobros individuales aparecerán en esta sección.</p>
                    </div>

                <% } %>

            </section>


            <!-- GASTOS -->

            <section class="detail-card">

                <div class="card-heading">
                    <div>
                        <h2>Gastos</h2>
                        <p>Costos adicionales relacionados con el trabajo.</p>
                    </div>
                </div>

                <% if (listaGastos.length) { %>

                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Concepto</th>
                                    <th>Categoría</th>
                                    <th>Importe</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% listaGastos.forEach(g => { %>
                                    <tr>
                                        <td><%= fecha(g.fecha_gasto) %></td>
                                        <td><%= g.descripcion || "—" %></td>
                                        <td><%= g.categoria || "—" %></td>
                                        <td>$ <%= dinero(g.monto) %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } else { %>

                    <div class="empty-state">
                        <span>🧾</span>
                        <strong>No hay gastos registrados</strong>
                        <p>Los gastos asociados aparecerán en esta sección.</p>
                    </div>

                <% } %>

            </section>


            <!-- ARCHIVOS -->

            <section class="detail-card">

                <div class="card-heading">
                    <div>
                        <h2>Fotografías y archivos</h2>
                        <p>Documentación relacionada con la reparación.</p>
                    </div>
                </div>

                <% if (listaArchivos.length) { %>

                    <div class="files-list">

                        <% listaArchivos.forEach(a => { %>

                            <div class="file-item">
                                <div class="file-icon">📎</div>

                                <div class="file-info">
                                    <strong>
                                        <%= a.nombre_original || "Archivo" %>
                                    </strong>
                                    <small>
                                        <%= a.categoria || a.tipo || "Documento" %>
                                    </small>
                                </div>

                                <% if (a.ruta_archivo) { %>
                                    <a href="<%= a.ruta_archivo %>" target="_blank" rel="noopener">
                                        Abrir
                                    </a>
                                <% } %>
                            </div>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="empty-state">
                        <span>📷</span>
                        <strong>No hay archivos adjuntos</strong>
                        <p>Las fotografías y comprobantes se podrán consultar aquí.</p>
                    </div>

                <% } %>

            </section>


            <!-- OBSERVACIONES -->

            <section class="detail-card">

                <div class="card-heading">
                    <div>
                        <h2>Observaciones</h2>
                    </div>
                </div>

                <div class="content-box">
                    <%= t.observaciones || "Sin observaciones." %>
                </div>

            </section>

        </main>


        <!-- COLUMNA LATERAL -->

        <aside class="side-column">

            <section class="detail-card">

                <h2>Estado del trabajo</h2>

                <form
                    action="/panel/servicios-tecnicos/trabajos/<%= t.id %>/estado"
                    method="POST">

                    <label class="side-label">Cambiar estado</label>

                    <select name="estado" class="side-select">

                        <% Object.keys(estados).forEach(e => { %>
                            <option
                                value="<%= e %>"
                                <%= estadoActual === e ? "selected" : "" %>>
                                <%= estados[e] %>
                            </option>
                        <% }) %>

                    </select>

                    <button class="btn-primary full-button" type="submit">
                        Actualizar estado
                    </button>

                </form>

            </section>


            <section class="detail-card">

                <h2>Resumen económico</h2>

                <div class="side-finance-row">
                    <span>Mano de obra</span>
                    <strong>$ <%= dinero(t.mano_obra) %></strong>
                </div>

                <div class="side-finance-row">
                    <span>Repuestos</span>
                    <strong>$ <%= dinero(t.costo_repuestos) %></strong>
                </div>

                <div class="side-finance-row">
                    <span>Total</span>
                    <strong>$ <%= dinero(totalTrabajo) %></strong>
                </div>

                <div class="side-finance-row">
                    <span>Cobrado</span>
                    <strong class="positive">$ <%= dinero(cobradoTrabajo) %></strong>
                </div>

                <div class="side-finance-row side-balance">
                    <span>Saldo pendiente</span>
                    <strong>$ <%= dinero(saldoTrabajo) %></strong>
                </div>

            </section>


            <section class="detail-card">

                <h2>Información del expediente</h2>

                <div class="side-info">
                    <span>Identificador</span>
                    <strong>#<%= t.id %></strong>
                </div>

                <div class="side-info">
                    <span>Orden asociada</span>
                    <strong>#<%= t.orden_id %></strong>
                </div>

                <div class="side-info">
                    <span>Visitas vinculadas</span>
                    <strong><%= listaVisitas.length %></strong>
                </div>

                <div class="side-info">
                    <span>Última actualización</span>
                    <strong><%= fecha(t.updated_at) %></strong>
                </div>

                <a
                    href="/panel/servicios-tecnicos/ordenes/<%= t.orden_id %>"
                    class="order-link">
                    Ver orden completa →
                </a>

            </section>

        </aside>

    </div>

</div>


<style>
.trabajo-detalle {
    max-width: 1450px;
    margin: auto;
    padding: 25px;
    color: var(--text-color, #263244);
}

.top-navigation {
    display: flex;
    gap: 9px;
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 20px;
}

.top-navigation a {
    color: #3b82f6;
    text-decoration: none;
}

.detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
}

.title-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

.title-line h1 {
    font-size: 25px;
    margin: 0;
    font-weight: 750;
}

.header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 17px;
    margin-top: 12px;
    color: #8490a2;
    font-size: 12px;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    background: #f1f5f9;
    color: #475569;
}

.status-pendiente {
    background: #fff7ed;
    color: #c2410c;
}

.status-en_proceso {
    background: #eff6ff;
    color: #2563eb;
}

.status-pausado {
    background: #fefce8;
    color: #a16207;
}

.status-terminado {
    background: #ecfdf5;
    color: #047857;
}

.status-cancelado {
    background: #fef2f2;
    color: #b91c1c;
}

.btn-secondary,
.btn-primary {
    border: none;
    border-radius: 9px;
    padding: 11px 15px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 650;
    cursor: pointer;
    display: inline-flex;
    justify-content: center;
    align-items: center;
}

.btn-secondary {
    background: #eff6ff;
    color: #2563eb;
}

.btn-primary {
    background: #2563eb;
    color: #fff;
}

.full-button {
    width: 100%;
    margin-top: 12px;
}

.metrics-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 13px;
    margin-bottom: 22px;
}

.metric-card {
    background: var(--card-bg, #fff);
    border: 1px solid var(--border-color, #e5eaf1);
    border-radius: 12px;
    padding: 18px;
}

.metric-label {
    color: #94a3b8;
    font-size: 11px;
    margin-bottom: 10px;
}

.metric-value {
    font-size: 19px;
    font-weight: 750;
}

.metric-highlight {
    border-color: #bfdbfe;
    background: #f8fbff;
}

.positive {
    color: #059669 !important;
}

.warning {
    color: #d97706 !important;
}

.detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 20px;
    align-items: start;
}

.main-column,
.side-column {
    min-width: 0;
}

.detail-card {
    background: var(--card-bg, #fff);
    border: 1px solid var(--border-color, #e5eaf1);
    border-radius: 13px;
    padding: 22px;
    margin-bottom: 17px;
    box-shadow: 0 3px 12px rgba(15, 23, 42, .025);
}

.detail-card h2 {
    font-size: 15px;
    margin: 0 0 17px;
    font-weight: 750;
}

.card-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.card-heading h2 {
    margin: 0 0 5px;
}

.card-heading p {
    font-size: 11px;
    color: #94a3b8;
    margin: 0;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.info-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.info-item span {
    color: #94a3b8;
    font-size: 11px;
}

.info-item strong {
    font-size: 13px;
    font-weight: 650;
}

.text-section {
    border-top: 1px solid var(--border-color, #e5eaf1);
    margin-top: 23px;
    padding-top: 18px;
}

.text-section h3 {
    font-size: 12px;
    margin: 0 0 9px;
}

.text-section p,
.content-box {
    font-size: 13px;
    line-height: 1.7;
    white-space: pre-wrap;
    color: var(--text-color, #475569);
}

.content-box {
    background: var(--input-bg, #f8fafc);
    padding: 15px;
    border-radius: 9px;
    min-height: 45px;
}

.table-responsive {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    text-align: left;
}

th {
    color: #94a3b8;
    font-weight: 650;
    font-size: 10px;
    text-transform: uppercase;
    padding: 12px 10px;
    border-bottom: 1px solid var(--border-color, #e5eaf1);
    white-space: nowrap;
}

td {
    padding: 14px 10px;
    border-bottom: 1px solid var(--border-color, #edf0f5);
    white-space: nowrap;
}

.table-link {
    color: #2563eb;
    text-decoration: none;
    font-weight: 650;
}

.empty-state {
    text-align: center;
    padding: 25px 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.empty-state span {
    font-size: 27px;
}

.empty-state strong {
    font-size: 13px;
}

.empty-state p {
    color: #94a3b8;
    font-size: 11px;
    margin: 0;
}

.link-visit-form {
    border-top: 1px solid var(--border-color, #e5eaf1);
    padding-top: 18px;
    margin-top: 15px;
}

.link-visit-form label,
.side-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 8px;
}

.inline-form {
    display: flex;
    gap: 10px;
}

.inline-form select,
.side-select {
    min-width: 0;
    flex: 1;
    padding: 11px;
    border: 1px solid var(--border-color, #dce2ea);
    border-radius: 8px;
    background: var(--input-bg, #fff);
    color: var(--text-color, #263244);
    font-size: 12px;
}

.files-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.file-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--border-color, #e5eaf1);
    border-radius: 9px;
}

.file-icon {
    font-size: 21px;
}

.file-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
