<%
    const fechaInput = (valor) => {
        if (!valor) return "";
        return String(valor).substring(0, 10);
    };

    const valorNumero = (valor) => {
        const n = Number(valor);
        return Number.isFinite(n) ? n : 0;
    };

    const estados = [
        ["pendiente", "Pendiente"],
        ["en_proceso", "En proceso"],
        ["pausado", "Pausado"],
        ["terminado", "Terminado"],
        ["cancelado", "Cancelado"]
    ];

    const prioridades = [
        ["baja", "Baja"],
        ["normal", "Normal"],
        ["alta", "Alta"],
        ["urgente", "Urgente"]
    ];

    const rubros = [
        "Plomería",
        "Electricidad",
        "Refrigeración",
        "Construcción",
        "Gas",
        "Pintura",
        "Carpintería",
        "Herrería",
        "Otros"
    ];

    const rubroActual = trabajo.rubro || "";
    const rubroExiste = rubros.some(r => r.toLowerCase() === rubroActual.toLowerCase());
%>

<div class="editar-trabajo">

    <div class="page-header">
        <div>
            <div class="breadcrumb">
                <a href="/panel/servicios-tecnicos">Servicios técnicos</a>
                <span>/</span>
                <a href="/panel/servicios-tecnicos/trabajos">Trabajos</a>
                <span>/</span>
                <a href="/panel/servicios-tecnicos/trabajos/<%= trabajo.id %>">Detalle</a>
                <span>/</span>
                <strong>Editar</strong>
            </div>

            <h1>Editar trabajo</h1>
            <p>Modificá la información y los datos del trabajo registrado.</p>
        </div>

        <a class="btn-volver"
           href="/panel/servicios-tecnicos/trabajos/<%= trabajo.id %>">
            ← Volver al trabajo
        </a>
    </div>

    <form method="POST"
          action="/panel/servicios-tecnicos/trabajos/<%= trabajo.id %>/editar"
          id="formEditarTrabajo">

        <div class="form-layout">

            <!-- INFORMACIÓN GENERAL -->
            <section class="form-card">

                <div class="card-heading">
                    <div class="heading-icon">📋</div>
                    <div>
                        <h2>Información general</h2>
                        <p>Identificación y clasificación del trabajo.</p>
                    </div>
                </div>

                <div class="form-grid">

                    <div class="form-group full">
                        <label>Trabajo / Título *</label>
                        <input
                            type="text"
                            name="titulo"
                            value="<%= trabajo.titulo || '' %>"
                            placeholder="Ej. Reparación de pérdida de agua"
                            required
                            maxlength="200">
                    </div>

                    <div class="form-group">
                        <label>Rubro *</label>
                        <select name="rubro" required>
                            <option value="">Seleccionar rubro</option>

                            <% rubros.forEach(rubro => { %>
                                <option
                                    value="<%= rubro %>"
                                    <%= rubroActual.toLowerCase() === rubro.toLowerCase() ? "selected" : "" %>>
                                    <%= rubro %>
                                </option>
                            <% }) %>

                            <% if (rubroActual && !rubroExiste) { %>
                                <option value="<%= rubroActual %>" selected>
                                    <%= rubroActual %>
                                </option>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Prioridad</label>
                        <select name="prioridad">
                            <% prioridades.forEach(p => { %>
                                <option
                                    value="<%= p[0] %>"
                                    <%= (trabajo.prioridad || "normal") === p[0] ? "selected" : "" %>>
                                    <%= p[1] %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Estado</label>
                        <select name="estado">
                            <% estados.forEach(e => { %>
                                <option
                                    value="<%= e[0] %>"
                                    <%= (trabajo.estado || "pendiente") === e[0] ? "selected" : "" %>>
                                    <%= e[1] %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Orden asociada</label>
                        <input
                            type="text"
                            value="Orden #<%= trabajo.orden_id %>"
                            disabled>
                        <small>La orden original no se modifica desde esta pantalla.</small>
                    </div>

                    <div class="form-group full">
                        <label>Descripción</label>
                        <textarea
                            name="descripcion"
                            rows="3"
                            placeholder="Descripción detallada del trabajo..."><%= trabajo.descripcion || "" %></textarea>
                    </div>

                </div>
            </section>

            <!-- EQUIPO -->
            <section class="form-card">

                <div class="card-heading">
                    <div class="heading-icon">🔧</div>
                    <div>
                        <h2>Equipo / Instalación</h2>
                        <p>Datos del equipo sobre el que se realiza el trabajo.</p>
                    </div>
                </div>

                <div class="form-grid">

                    <div class="form-group">
                        <label>Equipo</label>
                        <input
                            type="text"
                            name="equipo"
                            value="<%= trabajo.equipo || '' %>"
                            placeholder="Ej. Aire acondicionado">
                    </div>

                    <div class="form-group">
                        <label>Marca</label>
                        <input
                            type="text"
                            name="marca"
                            value="<%= trabajo.marca || '' %>"
                            placeholder="Marca del equipo">
                    </div>

                    <div class="form-group">
                        <label>Modelo</label>
                        <input
                            type="text"
                            name="modelo"
                            value="<%= trabajo.modelo || '' %>"
                            placeholder="Modelo">
                    </div>

                </div>
            </section>

            <!-- DIAGNÓSTICO -->
            <section class="form-card">

                <div class="card-heading">
                    <div class="heading-icon">🔍</div>
                    <div>
                        <h2>Diagnóstico y ejecución</h2>
                        <p>Información técnica del trabajo.</p>
                    </div>
                </div>

                <div class="form-grid">

                    <div class="form-group full">
                        <label>Diagnóstico</label>
                        <textarea
                            name="diagnostico"
                            rows="4"
                            placeholder="Describí el problema detectado..."><%= trabajo.diagnostico || "" %></textarea>
                    </div>

                    <div class="form-group full">
                        <label>Trabajo realizado</label>
                        <textarea
                            name="trabajo_realizado"
                            rows="4"
                            placeholder="Detallá las tareas realizadas..."><%= trabajo.trabajo_realizado || "" %></textarea>
                    </div>

                    <div class="form-group">
                        <label>Fecha de inicio</label>
                        <input
                            type="date"
                            name="fecha_inicio"
                            value="<%= fechaInput(trabajo.fecha_inicio) %>">
                    </div>

                    <div class="form-group">
                        <label>Fecha de finalización</label>
                        <input
                            type="date"
                            name="fecha_finalizacion"
                            value="<%= fechaInput(trabajo.fecha_finalizacion) %>">
                    </div>

                </div>
            </section>

            <!-- IMPORTES -->
            <section class="form-card">

                <div class="card-heading">
                    <div class="heading-icon">💰</div>
                    <div>
                        <h2>Importes del trabajo</h2>
                        <p>Costos y valores económicos registrados.</p>
                    </div>
                </div>

                <div class="form-grid">

                    <div class="form-group">
                        <label>Mano de obra ($)</label>
                        <input
                            type="number"
                            name="mano_obra"
                            id="manoObra"
                            min="0"
                            step="0.01"
                            value="<%= valorNumero(trabajo.mano_obra) %>">
                    </div>

                    <div class="form-group">
                        <label>Costo de repuestos ($)</label>
                        <input
                            type="number"
                            name="costo_repuestos"
                            id="costoRepuestos"
                            min="0"
                            step="0.01"
                            value="<%= valorNumero(trabajo.costo_repuestos) %>">
                    </div>

                    <div class="form-group">
                        <label>Total del trabajo ($)</label>
                        <input
                            type="number"
                            name="total"
                            id="totalTrabajo"
                            min="0"
                            step="0.01"
                            value="<%= valorNumero(trabajo.total) %>">
                        <small>Podés modificar el total manualmente.</small>
                    </div>

                    <div class="form-group">
                        <label>Monto cobrado ($)</label>
                        <input
                            type="number"
                            name="monto_cobrado"
                            id="montoCobrado"
                            min="0"
                            step="0.01"
                            value="<%= valorNumero(trabajo.monto_cobrado) %>">
                    </div>

                </div>

                <div class="financial-summary">
                    <div>
                        <span>Total</span>
                        <strong id="resumenTotal">$0,00</strong>
                    </div>

                    <div>
                        <span>Cobrado</span>
                        <strong id="resumenCobrado">$0,00</strong>
                    </div>

                    <div>
                        <span>Saldo pendiente</span>
                        <strong id="resumenSaldo">$0,00</strong>
                    </div>
                </div>

            </section>

            <!-- OBSERVACIONES -->
            <section class="form-card">

                <div class="card-heading">
                    <div class="heading-icon">📝</div>
                    <div>
                        <h2>Observaciones</h2>
                        <p>Información adicional interna.</p>
                    </div>
                </div>

                <div class="form-group">
                    <textarea
                        name="observaciones"
                        rows="4"
                        placeholder="Observaciones del trabajo..."><%= trabajo.observaciones || "" %></textarea>
                </div>

            </section>

        </div>

        <div class="form-actions">
            <a class="btn-cancelar"
               href="/panel/servicios-tecnicos/trabajos/<%= trabajo.id %>">
                Cancelar
            </a>

            <button type="submit" class="btn-guardar">
                Guardar cambios
            </button>
        </div>

    </form>

</div>

<style>
.editar-trabajo {
    max-width: 1150px;
    margin: 0 auto;
    padding: 24px;
    color: var(--text-color, #202938);
}

.editar-trabajo * {
    box-sizing: border-box;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 28px;
}

.breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 12px;
    color: #8b95a5;
    margin-bottom: 12px;
}

.breadcrumb a {
    color: #64748b;
    text-decoration: none;
}

.breadcrumb a:hover {
    color: #2563eb;
}

.page-header h1 {
    margin: 0;
    font-size: 27px;
    font-weight: 750;
}

.page-header p {
    color: #8993a3;
    margin: 7px 0 0;
    font-size: 14px;
}

.btn-volver,
.btn-cancelar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border: 1px solid #dce2ea;
    color: #475569;
    background: white;
    padding: 11px 16px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 650;
    cursor: pointer;
}

.form-layout {
    display: grid;
    gap: 20px;
}

.form-card {
    background: var(--card-bg, #fff);
    border: 1px solid var(--border-color, #e5e9f0);
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 3px 12px rgba(15, 23, 42, .035);
}

.card-heading {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 24px;
}

.heading-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eff6ff;
    border-radius: 11px;
    font-size: 19px;
}

.card-heading h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 750;
}

.card-heading p {
    margin: 5px 0 0;
    color: #94a0b0;
    font-size: 12px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-color, #475569);
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    min-width: 0;
    padding: 12px 13px;
    border: 1px solid var(--border-color, #dce2ea);
    border-radius: 8px;
    background: var(--input-bg, #fff);
    color: var(--text-color, #273449);
    font-family: inherit;
    font-size: 13px;
    outline: none;
    transition: border .2s, box-shadow .2s;
}

.form-group textarea {
    resize: vertical;
    line-height: 1.6;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, .10);
}

.form-group input:disabled {
    background: #f1f5f9;
    color: #64748b;
}

.form-group small {
    font-size: 11px;
    color: #94a3b8;
}

.financial-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 24px;
    padding: 18px;
    background: #f8fafc;
    border: 1px solid #e8edf3;
    border-radius: 10px;
}

.financial-summary div {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.financial-summary span {
    font-size: 11px;
    color: #8491a3;
}

.financial-summary strong {
    font-size: 19px;
    color: #263449;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 22px;
    padding-bottom: 30px;
}

.btn-guardar {
    border: 0;
    border-radius: 9px;
    padding: 12px 23px;
    background: #2563eb;
    color: white;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
}

.btn-guardar:hover {
    background: #1d4ed8;
}

@media (max-width: 700px) {
    .editar-trabajo {
        padding: 15px;
    }

    .page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .page-header h1 {
        font-size: 23px;
    }

    .form-card {
        padding: 17px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .financial-summary {
        grid-template-columns: 1fr;
    }

    .financial-summary strong {
        font-size: 17px;
    }

    .form-actions {
        flex-direction: column-reverse;
    }

    .form-actions button,
    .form-actions a {
        width: 100%;
    }
}
</style>

<script>
(() => {
    const manoObra = document.getElementById("manoObra");
    const repuestos = document.getElementById("costoRepuestos");
    const total = document.getElementById("totalTrabajo");
    const cobrado = document.getElementById("montoCobrado");

    const resumenTotal = document.getElementById("resumenTotal");
    const resumenCobrado = document.getElementById("resumenCobrado");
    const resumenSaldo = document.getElementById("resumenSaldo");

    const formato = valor => {
        return Number(valor || 0).toLocaleString("es-AR", {
            style: "currency",
            currency: "ARS",
            minimumFractionDigits: 2
        });
    };

    function actualizarResumen() {
        const t = Number(total.value) || 0;
        const c = Number(cobrado.value) || 0;

        resumenTotal.textContent = formato(t);
        resumenCobrado.textContent = formato(c);
        resumenSaldo.textContent = formato(t - c);
    }

    function calcularTotal() {
        total.value = (
            (Number(manoObra.value) || 0) +
            (Number(repuestos.value) || 0)
        ).toFixed(2);

        actualizarResumen();
    }

    manoObra.addEventListener("input", calcularTotal);
    repuestos.addEventListener("input", calcularTotal);
    total.addEventListener("input", actualizarResumen);
    cobrado.addEventListener("input", actualizarResumen);

    actualizarResumen();

    document.getElementById("formEditarTrabajo").addEventListener("submit", event => {
        const totalValor = Number(total.value) || 0;
        const cobradoValor = Number(cobrado.value) || 0;

        if (totalValor < 0 || cobradoValor < 0) {
            event.preventDefault();
            alert("Los importes no pueden ser negativos.");
            return;
        }

        if (cobradoValor > totalValor) {
            event.preventDefault();
            alert("El monto cobrado no puede superar el total del trabajo.");
        }
    });
})();
</script>