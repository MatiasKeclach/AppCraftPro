<%
const formatoDinero = valor =>
    Number(valor || 0).toLocaleString("es-AR", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });

const estadoTexto = {
    pendiente: "Pendiente",
    en_proceso: "En proceso",
    pausado: "Pausado",
    terminado: "Terminado",
    cancelado: "Cancelado"
};

const estadoClase = {
    pendiente: "pending",
    en_proceso: "progress",
    pausado: "paused",
    terminado: "completed",
    cancelado: "cancelled"
};
%>

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trabajos | Servicios Técnicos</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
:root {
    --bg: #f4f6fb;
    --surface: #ffffff;
    --surface-soft: #f8fafc;
    --text: #172033;
    --muted: #748096;
    --border: #e5eaf2;
    --primary: #635bff;
    --primary-soft: #eeedff;
    --green: #15966b;
    --green-soft: #e7f8f1;
    --orange: #d97706;
    --orange-soft: #fff4df;
    --red: #dc4545;
    --red-soft: #fff0f0;
    --blue: #2775d7;
    --blue-soft: #eaf3ff;
    --shadow: 0 8px 28px rgba(25, 40, 70, .045);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, sans-serif;
}

.container {
    max-width: 1450px;
    margin: auto;
    padding: 32px;
}

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
    flex-wrap: wrap;
}

.eyebrow {
    color: var(--primary);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 9px;
}

h1 {
    font-size: 27px;
    letter-spacing: -.8px;
    margin: 0;
    font-weight: 800;
}

.subtitle {
    color: var(--muted);
    font-size: 13px;
    margin-top: 8px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px 17px;
    border-radius: 10px;
    border: 1px solid transparent;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: .2s;
}

.btn-primary {
    color: white;
    background: var(--primary);
    box-shadow: 0 5px 14px rgba(99, 91, 255, .2);
}

.btn-primary:hover {
    background: #5148ed;
    transform: translateY(-1px);
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.stat {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 19px;
    box-shadow: var(--shadow);
}

.stat-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
}

.stat-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
}

.stat-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-size: 14px;
}

.stat-value {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -.8px;
}

.stat-detail {
    color: var(--muted);
    font-size: 11px;
    margin-top: 5px;
}

.icon-purple { background: var(--primary-soft); color: var(--primary); }
.icon-orange { background: var(--orange-soft); color: var(--orange); }
.icon-blue { background: var(--blue-soft); color: var(--blue); }
.icon-green { background: var(--green-soft); color: var(--green); }

.panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: var(--shadow);
    overflow: hidden;
}

.panel-header {
    padding: 21px 23px;
    border-bottom: 1px solid var(--border);
}

.panel-title {
    font-size: 15px;
    font-weight: 800;
}

.panel-subtitle {
    color: var(--muted);
    font-size: 12px;
    margin-top: 5px;
}

.filters {
    display: flex;
    gap: 10px;
    padding: 17px 22px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
}

.input,
.select {
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface-soft);
    padding: 0 12px;
    font-family: inherit;
    font-size: 12px;
    color: var(--text);
    outline: none;
}

.input:focus,
.select:focus {
    border-color: var(--primary);
}

.search {
    flex: 1;
    min-width: 190px;
}

.filter-btn {
    height: 40px;
    padding: 0 15px;
    border: 0;
    border-radius: 9px;
    background: var(--primary-soft);
    color: var(--primary);
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
}

.table-wrap {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 850px;
}

th {
    text-align: left;
    padding: 14px 20px;
    background: #fafbfe;
    color: #8590a3;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .6px;
    white-space: nowrap;
}

td {
    padding: 16px 20px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    vertical-align: middle;
}

tbody tr {
    transition: .15s;
}

tbody tr:hover {
    background: #fafaff;
}

.work-title {
    color: var(--text);
    font-weight: 700;
    font-size: 12px;
}

.work-description {
    color: var(--muted);
    font-size: 11px;
    margin-top: 5px;
    max-width: 260px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.client {
    font-weight: 600;
}

.secondary {
    display: block;
    color: var(--muted);
    font-size: 10px;
    margin-top: 5px;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 30px;
    padding: 6px 9px;
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
}

.pending { color: #a66a00; background: var(--orange-soft); }
.progress { color: #2467c4; background: var(--blue-soft); }
.paused { color: #7553a5; background: #f3edff; }
.completed { color: #12815d; background: var(--green-soft); }
.cancelled { color: #c13d3d; background: var(--red-soft); }

.rubro {
    display: inline-block;
    padding: 6px 9px;
    border-radius: 7px;
    background: #f0f2f7;
    color: #59647a;
    font-size: 10px;
    font-weight: 700;
    text-transform: capitalize;
}

.money {
    font-weight: 800;
    white-space: nowrap;
}

.actions {
    display: flex;
    gap: 7px;
}

.action {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    transition: .2s;
}

.action:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: var(--primary-soft);
}

.empty {
    padding: 65px 20px;
    text-align: center;
}

.empty-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    margin: 0 auto 17px;
    border-radius: 16px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 23px;
}

.empty h3 {
    font-size: 15px;
    margin: 0 0 8px;
}

.empty p {
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 20px;
}

.footer {
    padding: 16px 22px;
    color: var(--muted);
    font-size: 11px;
    border-top: 1px solid var(--border);
}

@media (max-width: 900px) {
    .container { padding: 20px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 550px) {
    .container { padding: 15px; }
    .header { align-items: flex-start; }
    h1 { font-size: 23px; }
    .header .btn { width: 100%; }
    .stats { gap: 10px; }
    .stat { padding: 14px; }
    .stat-value { font-size: 22px; }
    .filters > * { width: 100%; }
}
</style>
</head>

<body>

<div class="container">

    <header class="header">
        <div>
            <div class="eyebrow">
                <i class="fa-solid fa-screwdriver-wrench"></i>
                Servicios técnicos
            </div>

            <h1>Trabajos individuales</h1>

            <div class="subtitle">
                Administrá cada reparación, su evolución y su historial.
            </div>
        </div>

        <a href="/panel/servicios-tecnicos/trabajos/nuevo"
           class="btn btn-primary">
            <i class="fa-solid fa-plus"></i>
            Nuevo trabajo
        </a>
    </header>


    <section class="stats">

        <div class="stat">
            <div class="stat-top">
                <span class="stat-label">Total de trabajos</span>
                <span class="stat-icon icon-purple">
                    <i class="fa-solid fa-clipboard-list"></i>
                </span>
            </div>

            <div class="stat-value"><%= estadisticas.total %></div>
            <div class="stat-detail">Trabajos encontrados</div>
        </div>

        <div class="stat">
            <div class="stat-top">
                <span class="stat-label">Pendientes</span>
                <span class="stat-icon icon-orange">
                    <i class="fa-regular fa-clock"></i>
                </span>
            </div>

            <div class="stat-value"><%= estadisticas.pendientes %></div>
            <div class="stat-detail">Esperando intervención</div>
        </div>

        <div class="stat">
            <div class="stat-top">
                <span class="stat-label">En proceso</span>
                <span class="stat-icon icon-blue">
                    <i class="fa-solid fa-gears"></i>
                </span>
            </div>

            <div class="stat-value"><%= estadisticas.enProceso %></div>
            <div class="stat-detail">Reparaciones activas</div>
        </div>

        <div class="stat">
            <div class="stat-top">
                <span class="stat-label">Terminados</span>
                <span class="stat-icon icon-green">
                    <i class="fa-solid fa-circle-check"></i>
                </span>
            </div>

            <div class="stat-value"><%= estadisticas.terminados %></div>
            <div class="stat-detail">Trabajos finalizados</div>
        </div>

    </section>


    <section class="panel">

        <div class="panel-header">
            <div class="panel-title">Registro de trabajos</div>
            <div class="panel-subtitle">
                Buscá y consultá las reparaciones registradas.
            </div>
        </div>


        <form class="filters" method="GET">

            <input
                class="input search"
                type="search"
                name="buscar"
                placeholder="Buscar por trabajo, cliente u orden..."
                value="<%= filtros.buscar || '' %>"
            >

            <select class="select" name="estado">
                <option value="">Todos los estados</option>

                <% estados = ["pendiente","en_proceso","pausado","terminado","cancelado"] %>

                <% estados.forEach(estado => { %>
                    <option
                        value="<%= estado %>"
                        <%= filtros.estado === estado ? "selected" : "" %>
                    >
                        <%= estadoTexto[estado] %>
                    </option>
                <% }) %>
            </select>

            <input
                class="input"
                type="text"
                name="rubro"
                placeholder="Rubro"
                value="<%= filtros.rubro || '' %>"
            >

            <button class="filter-btn" type="submit">
                <i class="fa-solid fa-filter"></i>
                Filtrar
            </button>

        </form>


        <% if (trabajos.length > 0) { %>

            <div class="table-wrap">

                <table>
                    <thead>
                        <tr>
                            <th>Trabajo</th>
                            <th>Cliente / Orden</th>
                            <th>Rubro</th>
                            <th>Estado</th>
                            <th>Visitas</th>
                            <th>Total</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                    <% trabajos.forEach(trabajo => { %>

                        <tr>

                            <td>
                                <div class="work-title">
                                    #<%= trabajo.id %> · <%= trabajo.titulo %>
                                </div>

                                <div class="work-description">
                                    <%= trabajo.descripcion || "Sin descripción adicional" %>
                                </div>
                            </td>

                            <td>
                                <span class="client">
                                    <%= trabajo.cliente_nombre %>
                                </span>

                                <span class="secondary">
                                    Orden #<%= trabajo.numero_orden %>
                                </span>
                            </td>

                            <td>
                                <span class="rubro">
                                    <%= trabajo.rubro || "General" %>
                                </span>
                            </td>

                            <td>
                                <span class="badge <%= estadoClase[trabajo.estado] || 'pending' %>">
                                    <%= estadoTexto[trabajo.estado] || trabajo.estado %>
                                </span>
                            </td>

                            <td>
                                <i class="fa-regular fa-calendar"
                                   style="color:#929caf;margin-right:5px"></i>
                                <%= trabajo.cantidad_visitas || 0 %>
                            </td>

                            <td>
                                <span class="money">
                                    $ <%= formatoDinero(trabajo.total) %>
                                </span>
                            </td>

                            <td>
                                <div class="actions">

                                    <a class="action"
                                       href="/panel/servicios-tecnicos/trabajos/<%= trabajo.id %>"
                                       title="Ver detalle">
                                        <i class="fa-regular fa-eye"></i>
                                    </a>

                                    <a class="action"
                                       href="/panel/servicios-tecnicos/trabajos/<%= trabajo.id %>/editar"
                                       title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                </div>
                            </td>

                        </tr>

                    <% }) %>

                    </tbody>
                </table>

            </div>

        <% } else { %>

            <div class="empty">

                <div class="empty-icon">
                    <i class="fa-solid fa-screwdriver-wrench"></i>
                </div>

                <h3>No hay trabajos registrados</h3>

                <p>
                    Cuando crees una reparación, aparecerá en este listado.
                </p>

                <a href="/panel/servicios-tecnicos/trabajos/nuevo"
                   class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i>
                    Crear primer trabajo
                </a>

            </div>

        <% } %>

        <div class="footer">
            Mostrando <strong><%= trabajos.length %></strong> trabajos.
        </div>

    </section>

</div>

</body>
</html>