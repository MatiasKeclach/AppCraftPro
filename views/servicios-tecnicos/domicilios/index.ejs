<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Agenda de visitas | Servicios Técnicos</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
:root {
    --bg:#f3f6fa;
    --surface:#fff;
    --soft:#f8fafc;
    --text:#17212f;
    --muted:#7c8999;
    --border:#e2e8f0;
    --primary:#0f9d9a;
    --primary-dark:#087d7a;
    --primary-light:rgba(15,157,154,.10);
    --shadow:0 12px 35px rgba(15,23,42,.06);
}

body.dark {
    --bg:#0d131b;
    --surface:#151e29;
    --soft:#111923;
    --text:#f1f5f9;
    --muted:#8996a6;
    --border:#273444;
    --primary-light:rgba(27,196,190,.12);
    --shadow:0 16px 45px rgba(0,0,0,.22);
}

* { box-sizing:border-box; }

body {
    margin:0;
    padding:28px;
    background:var(--bg);
    color:var(--text);
    font-family:Inter,sans-serif;
}

.container {
    max-width:1250px;
    margin:auto;
}

.topbar {
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    padding:14px 17px;
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:16px;
    margin-bottom:30px;
}

.brand {
    display:flex;
    align-items:center;
    gap:12px;
}

.brand-icon {
    width:44px;
    height:44px;
    border-radius:13px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,var(--primary),var(--primary-dark));
    color:white;
    font-size:18px;
}

.user-chip {
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar {
    width:36px;
    height:36px;
    border-radius:11px;
    background:var(--primary-light);
    color:var(--primary);
    display:flex;
    align-items:center;
    justify-content:center;
}

.user-chip div:last-child {
    display:flex;
    flex-direction:column;
    gap:3px;
}

.user-chip strong { font-size:13px; }
.user-chip span {
    color:var(--muted);
    font-size:10px;
    text-transform:capitalize;
}

.top-actions {
    display:flex;
    align-items:center;
    gap:9px;
}

.icon-btn {
    width:40px;
    height:40px;
    border:1px solid var(--border);
    border-radius:11px;
    background:var(--surface);
    color:var(--text);
    cursor:pointer;
}

.back {
    color:var(--muted);
    text-decoration:none;
    font-size:12px;
    font-weight:700;
}

.header {
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:20px;
    margin-bottom:25px;
}

.header h1 {
    margin:0;
    font-size:29px;
    font-weight:800;
    letter-spacing:-1px;
}

.header h1 i {
    color:var(--primary);
    margin-right:8px;
}

.header p {
    margin:9px 0 0;
    color:var(--muted);
    font-size:13px;
}

.btn {
    display:inline-flex;
    justify-content:center;
    align-items:center;
    gap:8px;
    padding:12px 16px;
    border-radius:11px;
    text-decoration:none;
    font-size:12px;
    font-weight:750;
    cursor:pointer;
    border:0;
}

.btn-primary {
    color:white;
    background:linear-gradient(135deg,var(--primary),var(--primary-dark));
    box-shadow:0 7px 18px rgba(15,157,154,.2);
}

.stats {
    display:grid;
    grid-template-columns:repeat(5,minmax(0,1fr));
    gap:13px;
    margin-bottom:22px;
}

.stat {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:15px;
    padding:17px;
    box-shadow:var(--shadow);
}

.stat-label {
    color:var(--muted);
    font-size:10px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.05em;
}

.stat-number {
    margin-top:9px;
    font-size:25px;
    font-weight:800;
}

.stat-icon {
    float:right;
    color:var(--primary);
    background:var(--primary-light);
    padding:9px;
    border-radius:10px;
}

.panel {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:17px;
    box-shadow:var(--shadow);
    overflow:hidden;
}

.filters {
    display:flex;
    align-items:center;
    gap:10px;
    padding:17px;
    border-bottom:1px solid var(--border);
    flex-wrap:wrap;
}

.filters input,
.filters select {
    min-height:42px;
    padding:10px 12px;
    border:1px solid var(--border);
    border-radius:10px;
    background:var(--soft);
    color:var(--text);
    font:inherit;
    font-size:12px;
    outline:none;
}

.filters input:focus,
.filters select:focus {
    border-color:var(--primary);
}

.search {
    flex:1;
    min-width:190px;
}

.table-wrap {
    overflow-x:auto;
}

table {
    width:100%;
    border-collapse:collapse;
    min-width:850px;
}

th {
    padding:14px 16px;
    text-align:left;
    color:var(--muted);
    background:var(--soft);
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.05em;
}

td {
    padding:15px 16px;
    border-top:1px solid var(--border);
    font-size:12px;
    vertical-align:middle;
}

tbody tr:hover {
    background:var(--primary-light);
}

.client-name {
    font-weight:750;
    font-size:12px;
}

.secondary {
    display:block;
    color:var(--muted);
    font-size:10px;
    margin-top:5px;
}

.badge {
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:6px 9px;
    border-radius:20px;
    font-size:10px;
    font-weight:800;
    white-space:nowrap;
}

.badge-programada {
    color:#a76508;
    background:rgba(245,158,11,.13);
}

.badge-realizada {
    color:#16834d;
    background:rgba(34,197,94,.13);
}

.badge-seguimiento {
    color:#2563a9;
    background:rgba(59,130,246,.13);
}

.badge-cancelada {
    color:#c34444;
    background:rgba(239,68,68,.13);
}

.action-link {
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:8px 10px;
    border:1px solid var(--border);
    border-radius:9px;
    color:var(--primary);
    text-decoration:none;
    font-size:11px;
    font-weight:750;
}

.action-link:hover {
    background:var(--primary-light);
}

.empty {
    padding:55px 20px;
    text-align:center;
    color:var(--muted);
}

.empty i {
    font-size:35px;
    color:var(--primary);
    margin-bottom:15px;
}

.empty h3 {
    color:var(--text);
    font-size:16px;
}

@media(max-width:900px) {
    body { padding:18px; }
    .stats { grid-template-columns:repeat(3,1fr); }
}

@media(max-width:600px) {
    body { padding:12px; }

    .topbar {
        align-items:flex-start;
        flex-direction:column;
    }

    .top-actions {
        width:100%;
        justify-content:space-between;
    }

    .header {
        align-items:stretch;
        flex-direction:column;
    }

    .header h1 { font-size:25px; }

    .stats {
        grid-template-columns:repeat(2,1fr);
        gap:9px;
    }

    .stat { padding:13px; }
    .stat-number { font-size:22px; }

    .filters {
        align-items:stretch;
        flex-direction:column;
    }

    .filters input,
    .filters select,
    .filters button {
        width:100%;
    }
}
</style>
</head>

<body>

<div class="container">

    <div class="topbar">
        <div class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-screwdriver-wrench"></i>
            </div>

            <div class="user-chip">
                <div class="avatar">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <strong><%= username || "Usuario" %></strong>
                    <span><%= role || "usuario" %></span>
                </div>
            </div>
        </div>

        <div class="top-actions">
            <a class="back" href="/panel/servicios-tecnicos">
                <i class="fa-solid fa-arrow-left"></i>
                Volver al panel
            </a>

            <button class="icon-btn" id="themeToggle" title="Cambiar tema">
                <i class="fa-solid fa-moon" id="themeIcon"></i>
            </button>
        </div>
    </div>

    <div class="header">
        <div>
            <h1>
                <i class="fa-solid fa-calendar-days"></i>
                Agenda de visitas
            </h1>
            <p>Organizá las visitas técnicas, los turnos y los trabajos pendientes.</p>
        </div>

        <a href="/panel/servicios-tecnicos/visitas/nueva" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i>
            Nueva visita
        </a>
    </div>

    <div class="stats">

        <div class="stat">
            <i class="fa-solid fa-calendar stat-icon"></i>
            <div class="stat-label">Total de visitas</div>
            <div class="stat-number"><%= resumen.total || 0 %></div>
        </div>

        <div class="stat">
            <i class="fa-solid fa-clock stat-icon"></i>
            <div class="stat-label">Programadas</div>
            <div class="stat-number"><%= resumen.programadas || 0 %></div>
        </div>

        <div class="stat">
            <i class="fa-solid fa-circle-check stat-icon"></i>
            <div class="stat-label">Realizadas</div>
            <div class="stat-number"><%= resumen.realizadas || 0 %></div>
        </div>

        <div class="stat">
            <i class="fa-solid fa-rotate stat-icon"></i>
            <div class="stat-label">Seguimiento</div>
            <div class="stat-number"><%= resumen.seguimiento || 0 %></div>
        </div>

        <div class="stat">
            <i class="fa-solid fa-ban stat-icon"></i>
            <div class="stat-label">Canceladas</div>
            <div class="stat-number"><%= resumen.canceladas || 0 %></div>
        </div>

    </div>

    <section class="panel">

        <form class="filters" method="GET">

            <input
                class="search"
                type="search"
                name="buscar"
                placeholder="Buscar cliente, teléfono, servicio o dirección..."
                value="<%= buscar || '' %>"
            >

            <select name="estado">
                <option value="">Todos los estados</option>
                <option value="programada" <%= estado === "programada" ? "selected" : "" %>>Programadas</option>
                <option value="realizada" <%= estado === "realizada" ? "selected" : "" %>>Realizadas</option>
                <option value="seguimiento" <%= estado === "seguimiento" ? "selected" : "" %>>Seguimiento</option>
                <option value="cancelada" <%= estado === "cancelada" ? "selected" : "" %>>Canceladas</option>
            </select>

            <input
                type="date"
                name="fecha"
                value="<%= fecha || '' %>"
                title="Filtrar por fecha"
            >

            <button class="btn btn-primary" type="submit">
                <i class="fa-solid fa-filter"></i>
                Filtrar
            </button>

            <a class="action-link" href="/panel/servicios-tecnicos/visitas">
                <i class="fa-solid fa-rotate-left"></i>
                Limpiar
            </a>

        </form>

        <% if (visitas && visitas.length > 0) { %>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha y hora</th>
                            <th>Cliente</th>
                            <th>Servicio</th>
                            <th>Dirección</th>
                            <th>Prioridad</th>
                            <th>Estado</th>
                            <th>Orden</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        <% visitas.forEach(v => {
                            const estadoActual = v.estado_visita || "programada";
                            const fechaTexto = v.fecha_programada
                                ? new Date(v.fecha_programada.replace(" ", "T")).toLocaleString("es-AR", {
                                    day:"2-digit",
                                    month:"2-digit",
                                    year:"numeric",
                                    hour:"2-digit",
                                    minute:"2-digit"
                                })
                                : "Sin fecha";

                            const etiquetaEstado = {
                                programada:"Programada",
                                realizada:"Realizada",
                                seguimiento:"Seguimiento",
                                cancelada:"Cancelada"
                            };
                        %>

                        <tr>
                            <td>
                                <strong><%= fechaTexto %></strong>
                                <span class="secondary">Visita #<%= v.visita_id %></span>
                            </td>

                            <td>
                                <div class="client-name"><%= v.cliente_nombre %></div>
                                <span class="secondary"><%= v.cliente_telefono || "Sin teléfono" %></span>
                            </td>

                            <td>
                                <strong><%= v.tipo_servicio || "Servicio técnico" %></strong>
                                <span class="secondary"><%= v.problema_reportado || "" %></span>
                            </td>

                            <td>
                                <%= v.direccion_servicio || "Sin dirección" %>
                                <span class="secondary"><%= v.localidad_servicio || "" %></span>
                            </td>

                            <td>
                                <%= v.prioridad || "Normal" %>
                            </td>

                            <td>
                                <span class="badge badge-<%= estadoActual %>">
                                    <%= etiquetaEstado[estadoActual] || estadoActual %>
                                </span>
                            </td>

                            <td>
                                #<%= v.orden_id %>
                            </td>

                            <td>
                                <a class="action-link" href="/panel/servicios-tecnicos/visitas/<%= v.visita_id %>">
                                    <i class="fa-solid fa-eye"></i>
                                    Ver
                                </a>
                            </td>
                        </tr>

                        <% }) %>
                    </tbody>
                </table>
            </div>

        <% } else { %>

            <div class="empty">
                <i class="fa-regular fa-calendar-xmark"></i>
                <h3>No hay visitas para mostrar</h3>
                <p>Probá cambiando los filtros o registrá una nueva visita.</p>

                <a href="/panel/servicios-tecnicos/visitas/nueva" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i>
                    Registrar visita
                </a>
            </div>

        <% } %>

    </section>

</div>

<script>
const themeToggle = document.getElementById("themeToggle");
const themeIcon = document.getElementById("themeIcon");

const theme = localStorage.getItem("servicios-theme");

if (theme === "dark") {
    document.body.classList.add("dark");
    themeIcon.className = "fa-solid fa-sun";
}

themeToggle.addEventListener("click", () => {
    document.body.classList.toggle("dark");

    const dark = document.body.classList.contains("dark");

    themeIcon.className = dark
        ? "fa-solid fa-sun"
        : "fa-solid fa-moon";

    localStorage.setItem(
        "servicios-theme",
        dark ? "dark" : "light"
    );
});
</script>

</body>
</html>