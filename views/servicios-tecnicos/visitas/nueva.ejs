</div>

<script>

/* =========================
   CLIENTES
========================= */

const cliente = document.getElementById("cliente");
const domicilio = document.getElementById("domicilio");

cliente.addEventListener("change", () => {

    // Si elige dar de alta un cliente nuevo
    if (cliente.value === "__nuevo_cliente__") {

        window.location.href =
            "/panel/servicios-tecnicos/clientes/nuevo?volver=/panel/servicios-tecnicos/visitas/nueva";

        return;
    }

    domicilio.value = "";

    Array.from(domicilio.options).forEach(option => {

        if (!option.value) return;

        option.hidden =
            option.dataset.cliente !== cliente.value;

    });

    document.getElementById("direccion").value = "";
    document.getElementById("localidad").value = "";

});


/* =========================
   DOMICILIOS
========================= */

domicilio.addEventListener("change", () => {

    const option =
        domicilio.selectedOptions[0];

    if (!option || !option.value) return;

    document.getElementById("direccion").value =
        option.dataset.direccion || "";

    document.getElementById("localidad").value =
        option.dataset.localidad || "";

});


/* =========================
   FECHA ACTUAL
========================= */

const ahora = new Date();

ahora.setMinutes(
    ahora.getMinutes() -
    ahora.getTimezoneOffset()
);

document.getElementById("fecha").value =
    ahora.toISOString().slice(0, 16);


/* =========================
   DARK MODE
========================= */

const themeToggle =
    document.getElementById("themeToggle");

const themeIcon =
    document.getElementById("themeIcon");

const savedTheme =
    localStorage.getItem("servicios-theme");

if (savedTheme === "dark") {

    document.body.classList.add("dark");

    themeIcon.className =
        "fa-solid fa-sun";

}

themeToggle.addEventListener("click", () => {

    document.body.classList.toggle("dark");

    const dark =
        document.body.classList.contains("dark");

    themeIcon.className =
        dark
            ? "fa-solid fa-sun"
            : "fa-solid fa-moon";

    localStorage.setItem(
        "servicios-theme",
        dark ? "dark" : "light"
    );

});

</script>

