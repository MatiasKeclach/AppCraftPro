<!DOCTYPE html>

<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Nueva visita | Servicios Técnicos</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>

/* =====================================================
   NUEVA VISITA · SERVICIOS TÉCNICOS
   ESTILO PROFESIONAL / APPCRAFTPRO
===================================================== */

:root {
    --bg: #f3f6fa;
    --bg-accent: #eaf3f3;

    --surface: #ffffff;
    --surface-soft: #f8fafc;
    --surface-hover: #f3f7f8;

    --text: #17212f;
    --text-soft: #536174;
    --muted: #7c8999;

    --border: #e2e8f0;
    --border-strong: #d5dee8;

    --primary: #0f9d9a;
    --primary-dark: #087d7a;
    --primary-light: rgba(15, 157, 154, .10);

    --danger: #d9534f;

    --shadow-sm: 0 2px 5px rgba(15, 23, 42, .025);
    --shadow: 0 12px 35px rgba(15, 23, 42, .07);
    --shadow-hover: 0 18px 45px rgba(15, 23, 42, .10);

    --radius-sm: 10px;
    --radius: 16px;
    --radius-lg: 20px;
}


/* =====================================================
   DARK MODE
===================================================== */

body.dark {
    --bg: #0d131b;
    --bg-accent: #101b22;

    --surface: #151e29;
    --surface-soft: #111923;
    --surface-hover: #1b2734;

    --text: #f1f5f9;
    --text-soft: #b5c0cc;
    --muted: #8996a6;

    --border: #273444;
    --border-strong: #344354;

    --primary-light: rgba(27, 196, 190, .12);

    --shadow-sm: 0 2px 8px rgba(0, 0, 0, .12);
    --shadow: 0 16px 45px rgba(0, 0, 0, .22);
    --shadow-hover: 0 20px 55px rgba(0, 0, 0, .32);
}


/* =====================================================
   RESET
===================================================== */

* {
    box-sizing: border-box;
}

html {
    min-height: 100%;
}

body {
    margin: 0;
    min-height: 100vh;
    padding: 32px;

    background:
        radial-gradient(
            circle at top left,
            var(--bg-accent),
            transparent 32%
        ),
        var(--bg);

    color: var(--text);
    font-family: "Inter", sans-serif;

    -webkit-font-smoothing: antialiased;

    transition:
        background .25s ease,
        color .25s ease;
}

button,
input,
select,
textarea {
    font: inherit;
}


/* =====================================================
   CONTENEDOR
===================================================== */

.container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
}


/* =====================================================
   BARRA SUPERIOR
===================================================== */

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding: 13px 16px;

    margin-bottom: 34px;

    background: color-mix(
        in srgb,
        var(--surface) 88%,
        transparent
    );

    border: 1px solid var(--border);
    border-radius: var(--radius);

    box-shadow: var(--shadow-sm);

    backdrop-filter: blur(12px);
}


/* Marca / Usuario */

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand-icon {
    width: 46px;
    height: 46px;

    flex: 0 0 46px;

    border-radius: 14px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-dark)
        );

    color: #fff;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 19px;

    box-shadow:
        0 8px 20px rgba(15, 157, 154, .24);
}


/* =====================================================
   INFORMACIÓN DEL USUARIO
===================================================== */

.user-info {
    display: flex;
    align-items: center;
    gap: 11px;
}

.user-info > i {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: var(--primary-light);
    color: var(--primary);

    font-size: 19px;
}

.user-info div {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.user-info strong {
    color: var(--text);

    font-size: 13px;
    font-weight: 700;

    line-height: 1.2;
}

.user-info span {
    display: inline-flex;
    align-items: center;

    width: fit-content;

    color: var(--primary);

    font-size: 10px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: .06em;
}


/* =====================================================
   ACCIONES SUPERIORES
===================================================== */

.top-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.back {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    padding: 10px 13px;

    border-radius: 10px;

    color: var(--text-soft);

    text-decoration: none;

    font-size: 12px;
    font-weight: 700;

    transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;
}

.back:hover {
    background: var(--surface-hover);
    color: var(--primary);
    transform: translateX(-2px);
}

.icon-btn {
    width: 42px;
    height: 42px;

    border: 1px solid var(--border);
    border-radius: 12px;

    background: var(--surface);
    color: var(--text);

    display: inline-flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 16px;

    box-shadow: var(--shadow-sm);

    transition:
        border-color .2s ease,
        color .2s ease,
        transform .2s ease,
        background .2s ease;
}

.icon-btn:hover {
    border-color: var(--primary);
    background: var(--primary-light);
    color: var(--primary);

    transform: translateY(-2px);
}


/* =====================================================
   ENCABEZADO
===================================================== */

.header {
    position: relative;

    display: flex;
    justify-content: space-between;
    align-items: flex-end;

    gap: 20px;

    margin-bottom: 28px;

    padding: 0 4px;
}

.header::before {
    content: "";

    display: block;

    width: 42px;
    height: 4px;

    margin-bottom: 15px;

    border-radius: 99px;

    background:
        linear-gradient(
            90deg,
            var(--primary),
            #48c7c4
        );
}

.header h1 {
    margin: 0;

    color: var(--text);

    font-size: clamp(25px, 3vw, 31px);
    font-weight: 800;

    letter-spacing: -.045em;
}

.header h1 i {
    margin-right: 9px;

    color: var(--primary);

    font-size: .86em;
}

.header p {
    max-width: 600px;

    margin: 9px 0 0;

    color: var(--muted);

    font-size: 13px;
    line-height: 1.6;
}


/* =====================================================
   TARJETAS
===================================================== */

.card {
    position: relative;

    overflow: hidden;

    margin-bottom: 22px;
    padding: 28px;

    background: var(--surface);

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);

    box-shadow: var(--shadow);

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

.card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-hover);
}


/* Línea decorativa superior */

.card::before {
    content: "";

    position: absolute;

    top: 0;
    left: 28px;

    width: 52px;
    height: 3px;

    border-radius: 0 0 5px 5px;

    background:
        linear-gradient(
            90deg,
            var(--primary),
            #4ed1cd
        );
}


/* =====================================================
   TÍTULO DE TARJETAS
===================================================== */

.card-title {
    display: flex;
    align-items: center;

    gap: 13px;

    padding-bottom: 19px;
    margin-bottom: 22px;

    border-bottom: 1px solid var(--border);
}

.card-title-icon {
    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: var(--primary-light);

    color: var(--primary);

    font-size: 17px;
}

.card h2 {
    margin: 0;

    color: var(--text);

    font-size: 16px;
    font-weight: 750;

    letter-spacing: -.015em;
}

.card-title p {
    margin: 4px 0 0;

    color: var(--muted);

    font-size: 11px;
    line-height: 1.45;
}


/* =====================================================
   GRID DEL FORMULARIO
===================================================== */

.grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 21px 20px;
}

.field {
    display: flex;
    flex-direction: column;

    gap: 8px;

    min-width: 0;
}

.field.full {
    grid-column: 1 / -1;
}


/* =====================================================
   LABELS
===================================================== */

label {
    display: flex;
    align-items: center;

    min-height: 16px;

    color: var(--text-soft);

    font-size: 11px;
    font-weight: 750;

    letter-spacing: .015em;
}


/* =====================================================
   CAMPOS
===================================================== */

input,
select,
textarea {
    width: 100%;

    border: 1px solid var(--border);
    border-radius: 11px;

    outline: none;

    padding: 13px 14px;

    background: var(--surface-soft);
    color: var(--text);

    font-size: 13px;
    line-height: 1.35;

    box-shadow:
        inset 0 1px 1px rgba(15, 23, 42, .015);

    transition:
        border-color .2s ease,
        background .2s ease,
        box-shadow .2s ease;
}

input:hover,
select:hover,
textarea:hover {
    border-color: var(--border-strong);
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--primary);

    background: var(--surface);

    box-shadow:
        0 0 0 4px var(--primary-light);
}

input::placeholder,
textarea::placeholder {
    color: var(--muted);
    opacity: .75;
}

select {
    cursor: pointer;
}

textarea {
    min-height: 120px;

    resize: vertical;
}


/* =====================================================
   BLOQUE NUEVO CLIENTE
===================================================== */

.client-help {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 18px;

    margin-top: 12px;
    padding: 13px 15px;

    background:
        linear-gradient(
            90deg,
            var(--primary-light),
            transparent
        );

    border: 1px solid rgba(15, 157, 154, .12);
    border-radius: 12px;

    color: var(--muted);

    font-size: 11px;
    line-height: 1.5;
}

.new-client-link {
    display: inline-flex;
    align-items: center;

    gap: 7px;

    padding: 8px 11px;

    border-radius: 8px;

    background: var(--surface);

    color: var(--primary);

    border: 1px solid rgba(15, 157, 154, .18);

    text-decoration: none;

    font-size: 11px;
    font-weight: 800;

    white-space: nowrap;

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}

.new-client-link:hover {
    background: var(--primary);
    color: white;

    transform: translateY(-1px);

    box-shadow:
        0 6px 16px rgba(15, 157, 154, .20);
}


/* =====================================================
   BOTONES DE ACCIÓN
===================================================== */

.actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;

    gap: 12px;

    padding: 8px 0 18px;

    margin-top: 24px;
}

.btn {
    min-height: 46px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    padding: 12px 21px;

    border-radius: 12px;

    font-family: inherit;
    font-size: 12px;
    font-weight: 750;

    text-decoration: none;

    cursor: pointer;

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        background .2s ease,
        border-color .2s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn:active {
    transform: translateY(0);
}

.btn-cancel {
    background: var(--surface);

    color: var(--text-soft);

    border: 1px solid var(--border);
}

.btn-cancel:hover {
    border-color: var(--border-strong);

    background: var(--surface-hover);
}

.btn-save {
    border: 1px solid transparent;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-dark)
        );

    color: #ffffff;

    box-shadow:
        0 8px 20px rgba(15, 157, 154, .23);
}

.btn-save:hover {
    box-shadow:
        0 13px 28px rgba(15, 157, 154, .30);
}


/* =====================================================
   RESPONSIVE - TABLET
===================================================== */

@media (max-width: 850px) {

    body {
        padding: 24px;
    }

    .topbar {
        margin-bottom: 28px;
    }

    .card {
        padding: 23px;
    }

}


/* =====================================================
   RESPONSIVE - MOBILE
===================================================== */

@media (max-width: 650px) {

    body {
        padding: 15px;
    }

    .container {
        max-width: 100%;
    }


    /* Barra superior */

    .topbar {
        align-items: stretch;
        flex-direction: column;

        gap: 14px;

        padding: 13px;

        margin-bottom: 25px;
    }

    .brand {
        width: 100%;
    }

    .top-actions {
        width: 100%;

        justify-content: space-between;

        padding-top: 11px;

        border-top: 1px solid var(--border);
    }


    /* Encabezado */

    .header {
        display: block;

        margin-bottom: 22px;

        padding: 0 2px;
    }

    .header::before {
        margin-bottom: 12px;
    }

    .header h1 {
        font-size: 26px;
    }

    .header p {
        font-size: 12px;
    }


    /* Cards */

    .card {
        padding: 19px 16px;

        border-radius: 16px;

        margin-bottom: 16px;
    }

    .card::before {
        left: 16px;
    }

    .card-title {
        align-items: flex-start;

        gap: 11px;

        margin-bottom: 19px;

        padding-bottom: 16px;
    }

    .card-title-icon {
        width: 38px;
        height: 38px;

        flex-basis: 38px;

        border-radius: 11px;
    }


    /* Formulario */

    .grid {
        grid-template-columns: 1fr;

        gap: 17px;
    }

    .field.full {
        grid-column: auto;
    }

    input,
    select,
    textarea {
        padding: 13px;
        font-size: 16px;
    }

    textarea {
        min-height: 110px;
    }


    /* Nuevo cliente */

    .client-help {
        align-items: flex-start;
        flex-direction: column;

        gap: 11px;

        padding: 13px;
    }

    .new-client-link {
        width: 100%;

        justify-content: center;

        padding: 10px;
    }


    /* Acciones */

    .actions {
        flex-direction: column-reverse;

        gap: 10px;

        margin-top: 16px;

        padding-bottom: 5px;
    }

    .actions .btn {
        width: 100%;

        min-height: 50px;
    }

}


/* =====================================================
   ACCESIBILIDAD
===================================================== */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
    }

}

.user-chip {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 7px 14px 7px 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
}

.user-avatar {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(15, 157, 154, .12);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
}

.user-chip div:last-child {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
}

.user-chip strong {
    font-size: 13px;
    color: var(--text);
}

.user-chip span {
    margin-top: 3px;
    font-size: 10px;
    color: var(--muted);
    text-transform: capitalize;
}

</style>

</head>

<body>

<div class="container">

```
<!-- BARRA SUPERIOR -->
<div class="topbar">

    <div class="brand">

        <div class="brand-icon">
            <i class="fa-solid fa-screwdriver-wrench"></i>
        </div>

       <!-- <div class="welcome">
            <strong>
                Bienvenido<%= typeof usuario !== "undefined" && usuario ? ", " + (usuario.nombre || usuario.username || "") : "" %>
            </strong>
            <span>Servicios Técnicos · Gestión de visitas</span>
        </div>
        <div class="user-info">
    <i class="fa-solid fa-user-circle"></i>-->
    
<div class="user-chip">
    <div class="user-avatar">
        <i class="fa-solid fa-user"></i>
    </div>

    <div>
        <strong><%= username || "Usuario" %></strong>
        <span><%= role || "usuario" %></span>
    </div>
</div>
    


    </div>

    <div class="top-actions">

        <a class="back" href="/panel/servicios-tecnicos">
            <i class="fa-solid fa-arrow-left"></i>
            Volver al panel
        </a>

        <button type="button" class="icon-btn" id="themeToggle" title="Cambiar modo">
            <i class="fa-solid fa-moon" id="themeIcon"></i>
        </button>

    </div>

</div>


<!-- ENCABEZADO -->
<div class="header">

    <div>
        <h1>
            <i class="fa-solid fa-calendar-plus"></i>
            Nueva visita
        </h1>

        <p>
            Registrá una nueva solicitud y organizá la próxima visita técnica.
        </p>
    </div>

</div>


<form action="/panel/servicios-tecnicos/visitas/nueva" method="POST">

    <!-- CLIENTE Y DOMICILIO -->
    <div class="card">

        <div class="card-title">

            <div class="card-title-icon">
                <i class="fa-solid fa-user"></i>
            </div>

            <div>
                <h2>Información del cliente</h2>
                <p>Seleccioná el cliente y el domicilio donde se realizará el servicio.</p>
            </div>

        </div>

        <div class="grid">

            <div class="field full">

                <label>Cliente *</label>

                <select name="cliente_id" id="cliente" required>

                    <option value="">Seleccionar cliente</option>

                    <% clientes.forEach(cliente => { %>
                        <option value="<%= cliente.id %>">
                            <%= cliente.nombre %> - <%= cliente.telefono || "Sin teléfono" %>
                        </option>
                    <% }) %>

                    <option value="__nuevo_cliente__">
                        ➕ Dar de alta un nuevo cliente
                    </option>

                </select>

                <div class="client-help">

                    <span>
                        ¿El cliente todavía no está registrado? Podés darlo de alta y continuar con esta visita.
                    </span>

                    <!-- CAMBIAR LA URL SI TU ALTA DE CLIENTE UTILIZA OTRA -->
                    <a
                        href="/panel/servicios-tecnicos/clientes/nuevo?volver=/panel/servicios-tecnicos/visitas/nueva"
                        class="new-client-link"
                        id="newClientLink">

                        <i class="fa-solid fa-user-plus"></i>
                        Nuevo cliente

                    </a>

                </div>

            </div>


            <div class="field full">

                <label>Domicilio registrado</label>

                <select name="domicilio_id" id="domicilio">

                    <option value="">
                        Seleccionar domicilio (opcional)
                    </option>

                    <% domicilios.forEach(d => { %>

                        <option
                            value="<%= d.id %>"
                            data-cliente="<%= d.cliente_id %>"
                            data-direccion="<%= d.direccion || '' %>"
                            data-localidad="<%= d.localidad || '' %>">

                            <%= d.alias || d.direccion %> - <%= d.localidad || "" %>

                        </option>

                    <% }) %>

                </select>

            </div>


            <div class="field">

                <label>Dirección del servicio</label>

                <input
                    type="text"
                    name="direccion_servicio"
                    id="direccion"
                    placeholder="Ej: Av. Rivadavia 1234, 2° B">

            </div>


            <div class="field">

                <label>Localidad</label>

                <input
                    type="text"
                    name="localidad_servicio"
                    id="localidad"
                    placeholder="Ej: San Justo">

            </div>

        </div>

    </div>


    <!-- DATOS DEL SERVICIO -->
    <div class="card">

        <div class="card-title">

            <div class="card-title-icon">
                <i class="fa-solid fa-screwdriver-wrench"></i>
            </div>

            <div>
                <h2>Datos del servicio</h2>
                <p>Indicá el tipo de trabajo y la información reportada.</p>
            </div>

        </div>

        <div class="grid">

            <div class="field">

                <label>Tipo de servicio *</label>

                <select name="tipo_servicio" required>

                    <option value="">Seleccionar servicio</option>
                    <option value="Aire acondicionado">Aire acondicionado</option>
                    <option value="Electricidad">Electricidad</option>
                    <option value="Plomería">Plomería</option>
                    <option value="Gas">Gas</option>
                    <option value="Refrigeración">Refrigeración</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                    <option value="Otro">Otro</option>

                </select>

            </div>


            <div class="field">

                <label>Prioridad</label>

                <select name="prioridad">

                    <option value="normal">Normal</option>
                    <option value="alta">Alta</option>
                    <option value="urgente">Urgente</option>

                </select>

            </div>


            <div class="field">

                <label>Fecha y hora de visita</label>

                <input
                    type="datetime-local"
                    name="fecha_programada"
                    id="fecha">

            </div>


            <div class="field full">

                <label>Problema informado por el cliente *</label>

                <textarea
                    name="problema_reportado"
                    placeholder="Describí el problema o trabajo solicitado..."
                    required></textarea>

            </div>


            <div class="field full">

                <label>Observaciones</label>

                <textarea
                    name="observaciones"
                    placeholder="Referencias, horarios disponibles, indicaciones o detalles adicionales..."></textarea>

            </div>

        </div>

    </div>


    <!-- ACCIONES -->
    <div class="actions">

        <a href="/panel/servicios-tecnicos" class="btn btn-cancel">
            <i class="fa-solid fa-xmark"></i>
            Cancelar
