<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#101827">

    <title>Agenda de visitas | Servicios Técnicos</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            color-scheme: dark;

            --bg: #0b1120;
            --surface: #111c2e;
            --surface-2: #172338;
            --surface-3: #1d2b42;
            --border: rgba(148,163,184,.15);

            --text: #f1f5f9;
            --muted: #94a3b8;

            --primary: #3b82f6;
            --success: #22c55e;
            --warning: #f59e0b;
            --danger: #ef4444;
            --purple: #a78bfa;

            --shadow: 0 12px 35px rgba(0,0,0,.22);
            --radius: 16px;
        }

        [data-theme="light"] {
            color-scheme: light;

            --bg: #f3f6fb;
            --surface: #fff;
            --surface-2: #f8fafc;
            --surface-3: #eef2f7;
            --border: #e2e8f0;

            --text: #172033;
            --muted: #64748b;

            --shadow: 0 10px 30px rgba(15,23,42,.06);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
            font-family: Inter, sans-serif;
            font-size: 14px;
            transition: background .2s, color .2s;
        }

        button, input, select {
            font: inherit;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button, a {
            -webkit-tap-highlight-color: transparent;
        }

        .container {
            width: min(1500px, 100%);
            margin: auto;
            padding: 28px;
        }

        /* HEADER */

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;
            min-width: 0;
        }

        .brand-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            flex: 0 0 46px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg,#2563eb,#7c3aed);
            color: white;
            font-size: 19px;
            font-weight: 800;
        }

        .brand h1 {
            font-size: 18px;
            font-weight: 800;
        }

        .brand p {
            color: var(--muted);
            font-size: 12px;
            margin-top: 4px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .user-info {
            color: var(--muted);
            font-size: 12px;
            padding: 10px 14px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
        }

        /* BUTTONS */

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 11px 15px;
            cursor: pointer;
            font-weight: 700;
            font-size: 12px;
            transition: .2s;
            background: var(--surface-2);
            color: var(--text);
            white-space: nowrap;
        }

        .btn:hover {
            transform: translateY(-1px);
            filter: brightness(1.12);
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .btn-success {
            color: var(--success);
            background: rgba(34,197,94,.12);
            border-color: rgba(34,197,94,.25);
        }

        .btn-small {
            padding: 8px 11px;
            font-size: 11px;
        }

        .theme-btn {
            width: 42px;
            height: 42px;
            padding: 0;
            font-size: 18px;
        }

        /* PAGE HEADING */

        .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .page-heading h2 {
            font-size: clamp(23px,3vw,30px);
            font-weight: 800;
            letter-spacing: -.8px;
        }

        .page-heading p {
            color: var(--muted);
            margin-top: 7px;
            line-height: 1.6;
        }

        .heading-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* STATS */

        .stats {
            display: grid;
            grid-template-columns: repeat(5,minmax(0,1fr));
            gap: 14px;
            margin-bottom: 23px;
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 19px;
            box-shadow: var(--shadow);
            min-width: 0;
        }

        .stat-label {
            color: var(--muted);
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .stat-value {
            font-size: 29px;
            font-weight: 800;
            margin-top: 10px;
        }

        .stat-detail {
            color: var(--muted);
            font-size: 11px;
            margin-top: 6px;
        }

        .stat-blue .stat-value { color: #60a5fa; }
        .stat-green .stat-value { color: var(--success); }
        .stat-yellow .stat-value { color: var(--warning); }
        .stat-purple .stat-value { color: var(--purple); }
        .stat-red .stat-value { color: var(--danger); }

        /* FILTERS */

        .filters-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 19px;
            margin-bottom: 20px;
        }

        .filters-title {
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .filters-form {
            display: grid;
            grid-template-columns: minmax(220px,2fr) repeat(2,minmax(150px,1fr)) auto auto;
            gap: 10px;
            align-items: end;
        }

        .filter-group {
            display: grid;
            gap: 7px;
            min-width: 0;
        }

        .filter-group label {
            color: var(--muted);
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .filter-group input,
        .filter-group select {
            width: 100%;
            min-width: 0;
            padding: 12px;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            outline: none;
        }

        .filter-group input:focus,
        .filter-group select:focus {
            border-color: var(--primary);
        }

        .filter-actions {
            display: flex;
            gap: 8px;
        }

        /* LIST HEADER */

        .list-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 13px;
            flex-wrap: wrap;
        }

        .list-header h3 {
            font-size: 15px;
            font-weight: 800;
        }

        .results-count {
            color: var(--muted);
            font-size: 11px;
        }

        /* TABLE */

        .table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 900px;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 15px 17px;
            background: var(--surface-2);
            color: var(--muted);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .5px;
            font-weight: 800;
            white-space: nowrap;
        }

        td {
            padding: 16px 17px;
            border-top: 1px solid var(--border);
            vertical-align: middle;
        }

        tbody tr {
            transition: background .2s;
        }

        tbody tr:hover {
            background: var(--surface-2);
        }

        .order-number {
            font-size: 12px;
            font-weight: 800;
            color: #60a5fa;
        }

        .visit-number {
            color: var(--muted);
            font-size: 10px;
            margin-top: 5px;
        }

        .client-name {
            font-size: 12px;
            font-weight: 800;
        }

        .client-phone {
            color: var(--muted);
            font-size: 11px;
            margin-top: 5px;
        }

        .service-name {
            font-weight: 700;
            font-size: 12px;
        }

        .service-address {
            color: var(--muted);
            font-size: 11px;
            margin-top: 5px;
            line-height: 1.5;
            max-width: 220px;
        }

        .date-main {
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .date-time {
            color: var(--muted);
            font-size: 11px;
            margin-top: 5px;
        }

        /* STATUS */

        .status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 10px;
            border-radius: 30px;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .3px;
            white-space: nowrap;
        }

        .status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .status-programada {
            color: #60a5fa;
            background: rgba(59,130,246,.13);
        }

        .status-realizada {
            color: #4ade80;
            background: rgba(34,197,94,.13);
        }

        .status-seguimiento {
            color: #fbbf24;
            background: rgba(245,158,11,.13);
        }

        .status-cancelada {
            color: #f87171;
            background: rgba(239,68,68,.13);
        }

        /* ACTIONS */

        .row-actions {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        /* EMPTY */

        .empty-state {
            padding: 65px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 65px;
            height: 65px;
            display: grid;
            place-items: center;
            margin: 0 auto 17px;
            border-radius: 20px;
            background: var(--surface-2);
            font-size: 28px;
        }

        .empty-state h3 {
            font-size: 17px;
            font-weight: 800;
        }

        .empty-state p {
            color: var(--muted);
            font-size: 12px;
            margin: 9px auto 20px;
            line-height: 1.6;
            max-width: 360px;
        }

        /* FOOTER */

        .footer {
            padding: 27px 0 5px;
            color: var(--muted);
            font-size: 11px;
            text-align: center;
            line-height: 1.7;
        }

        /* RESPONSIVE */

        @media(max-width:1100px) {
            .stats {
                grid-template-columns: repeat(3,minmax(0,1fr));
            }

            .filters-form {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }

            .filter-actions {
                grid-column: 1/-1;
            }
        }

        @media(max-width:650px) {
            .container {
                padding: 16px;
            }

            .topbar {
                align-items: flex-start;
            }

            .top-actions {
                width: 100%;
            }

            .user-info {
                flex: 1;
            }

            .page-heading {
                display: block;
            }

            .heading-actions {
                margin-top: 16px;
            }

            .heading-actions .btn {
                flex: 1;
            }

            .stats {
                grid-template-columns: repeat(2,minmax(0,1fr));
                gap: 9px;
            }

            .stat-card {
                padding: 14px;
            }

            .stat-value {
                font-size: 24px;
            }

            .filters-card {
                padding: 15px;
            }

            .filters-form {
                grid-template-columns: 1fr;
            }

            .filter-actions {
                grid-column: auto;
            }

            .filter-actions .btn {
                flex: 1;
            }

            .table-card {
                border-radius: 12px;
            }

            .list-header {
                align-items: flex-start;
            }
        }

        /* PRINT */

        @media print {
            :root {
                color-scheme: light;
                --bg: white;
                --surface: white;
                --surface-2: #f5f5f5;
                --border: #ddd;
                --text: #111;
                --muted: #555;
                --shadow: none;
            }

            body {
                background: white;
                color: black;
            }

            .container {
                max-width: 100%;
                padding: 0;
            }

            .top-actions,
            .heading-actions,
            .filters-card,
            .row-actions,
            .footer {
                display: none !important;
            }

            .stats {
                grid-template-columns: repeat(5,1fr);
            }

            .table-card,
            .stat-card {
                box-shadow: none;
            }

            .table-wrapper {
                overflow: visible;
            }

            table {
                min-width: 0;
            }
        }
    </style>
</head>

<body>

<%
    const lista = Array.isArray(visitas) ? visitas : [];

    const estados = {
        programada: "Programada",
        realizada: "Realizada",
        seguimiento: "Seguimiento",
        cancelada: "Cancelada"
    };

    const clasesEstado = {
        programada: "status-programada",
        realizada: "status-realizada",
        seguimiento: "status-seguimiento",
        cancelada: "status-cancelada"
    };

    const totalVisitas = Number(resumen?.total) || 0;
    const programadas = Number(resumen?.programadas) || 0;
    const realizadas = Number(resumen?.realizadas) || 0;
    const seguimiento = Number(resumen?.seguimiento) || 0;
    const canceladas = Number(resumen?.canceladas) || 0;

    function escaparFecha(fecha) {
        if (!fecha) return {
            fecha: "Sin fecha",
            hora: ""
        };

        const valor = String(fecha);
        const d = new Date(
            valor.includes("T") ? valor : valor.replace(" ", "T")
        );

        if (Number.isNaN(d.getTime())) {
            return {
                fecha: valor,
                hora: ""
            };
        }

        return {
            fecha: d.toLocaleDateString("es-AR"),
            hora: d.toLocaleTimeString("es-AR", {
                hour: "2-digit",
                minute: "2-digit"
            })
        };
    }

    function textoSeguro(valor) {
        return valor !== null &&
               valor !== undefined &&
               String(valor).trim() !== ""
            ? valor
            : "No registrado";
    }
%>

<div class="container">

    <!-- HEADER -->

    <header class="topbar">

        <div class="brand">
            <div class="brand-icon" aria-hidden="true">
                <span>ST</span>
            </div>

            <div>
                <h1>Servicios Técnicos</h1>
                <p>Gestión profesional de servicios y visitas</p>
            </div>
        </div>

        <div class="top-actions">

            <div class="user-info">
                Usuario:
                <strong><%= username || "Usuario" %></strong>
                · <%= role || "usuario" %>
            </div>

            <button
                class="btn theme-btn"
                type="button"
                id="themeToggle"
                title="Cambiar tema"
            >☀️</button>

        </div>

    </header>


    <!-- TITULO -->

    <section class="page-heading">

        <div>
            <h2>Agenda de visitas</h2>

            <p>
                Administrá, consultá y organizá las visitas técnicas.
            </p>
        </div>

        <div class="heading-actions">

            <a
                href="/panel/servicios-tecnicos"
                class="btn"
            >
                ← Panel principal
            </a>

            <a
                href="/panel/servicios-tecnicos/visitas/nueva"
                class="btn btn-primary"
            >
                + Registrar visita
            </a>

        </div>

    </section>


    <!-- INDICADORES -->

    <section class="stats">

        <div class="stat-card stat-blue">
            <div class="stat-label">Total de visitas</div>
            <div class="stat-value"><%= totalVisitas %></div>
            <div class="stat-detail">Historial general</div>
        </div>

        <div class="stat-card stat-yellow">
            <div class="stat-label">Programadas</div>
            <div class="stat-value"><%= programadas %></div>
            <div class="stat-detail">Visitas pendientes</div>
        </div>

        <div class="stat-card stat-green">
            <div class="stat-label">Realizadas</div>
            <div class="stat-value"><%= realizadas %></div>
            <div class="stat-detail">Trabajos completados</div>
        </div>

        <div class="stat-card stat-purple">
            <div class="stat-label">Seguimiento</div>
            <div class="stat-value"><%= seguimiento %></div>
            <div class="stat-detail">Requieren atención</div>
        </div>

        <div class="stat-card stat-red">
            <div class="stat-label">Canceladas</div>
            <div class="stat-value"><%= canceladas %></div>
            <div class="stat-detail">Visitas canceladas</div>
        </div>

    </section>


    <!-- FILTROS -->

    <section class="filters-card">

        <div class="filters-title">
            🔎 Buscar y filtrar visitas
        </div>

        <form
            action="/panel/servicios-tecnicos/visitas"
            method="GET"
            class="filters-form"
        >

            <div class="filter-group">

                <label for="buscar">Buscar</label>

                <input
                    type="search"
                    name="buscar"
                    id="buscar"
                    placeholder="Cliente, teléfono, servicio, dirección..."
                    value="<%= buscar || '' %>"
                >

            </div>

            <div class="filter-group">

                <label for="estado">Estado</label>

                <select name="estado" id="estado">

                    <option value="">Todos los estados</option>

                    <option value="programada" <%= estado === "programada" ? "selected" : "" %>>
                        Programadas
                    </option>

                    <option value="realizada" <%= estado === "realizada" ? "selected" : "" %>>
                        Realizadas
                    </option>

                    <option value="seguimiento" <%= estado === "seguimiento" ? "selected" : "" %>>
                        Seguimiento
                    </option>

                    <option value="cancelada" <%= estado === "cancelada" ? "selected" : "" %>>
                        Canceladas
                    </option>

                </select>

            </div>

            <div class="filter-group">

                <label for="fecha">Fecha programada</label>

                <input
                    type="date"
                    name="fecha"
                    id="fecha"
                    value="<%= fecha || '' %>"
                >

            </div>

            <div class="filter-actions">

                <button type="submit" class="btn btn-primary">
                    Buscar
                </button>

                <a
                    href="/panel/servicios-tecnicos/visitas"
                    class="btn"
                >
                    Limpiar
                </a>

            </div>

        </form>

    </section>


    <!-- LISTADO -->

    <section>

        <div class="list-header">

            <h3>Listado de visitas</h3>

            <span class="results-count">
                <%= lista.length %>
                <%= lista.length === 1 ? "resultado" : "resultados" %>
                encontrados
            </span>

        </div>


        <div class="table-card">

            <% if (lista.length > 0) { %>

                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Orden / Visita</th>
                                <th>Cliente</th>
                                <th>Servicio</th>
                                <th>Domicilio</th>
                                <th>Fecha y hora</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% lista.forEach(visita => {
                                const fechaVisita = escaparFecha(visita.fecha_programada);
                                const estadoVisita = visita.estado_visita || "programada";
                            %>

                                <tr>

                                    <td>
                                        <div class="order-number">
                                            Orden #<%= visita.orden_id %>
                                        </div>

                                        <div class="visit-number">
                                            Visita #<%= visita.numero_visita || 1 %>
                                        </div>
                                    </td>

                                    <td>

                                        <div class="client-name">
                                            <%= textoSeguro(visita.cliente_nombre) %>
                                        </div>

                                        <div class="client-phone">
                                            <%= textoSeguro(visita.cliente_telefono) %>
                                        </div>

                                    </td>

                                    <td>

                                        <div class="service-name">
                                            <%= textoSeguro(visita.tipo_servicio) %>
                                        </div>

                                        <div class="service-address">
                                            <%= textoSeguro(visita.problema_reportado) %>
                                        </div>

                                    </td>

                                    <td>

                                        <div class="service-name">
                                            <%= textoSeguro(visita.direccion_servicio) %>
                                        </div>

                                        <div class="service-address">
                                            <%= textoSeguro(visita.localidad_servicio) %>
                                        </div>

                                    </td>

                                    <td>

                                        <div class="date-main">
                                            <%= fechaVisita.fecha %>
                                        </div>

                                        <div class="date-time">
                                            <%= fechaVisita.hora || "Horario no registrado" %>
                                        </div>

                                    </td>

                                    <td>

                                        <span class="status <%= clasesEstado[estadoVisita] || 'status-programada' %>">
                                            <%= estados[estadoVisita] || estadoVisita %>
                                        </span>

                                    </td>

                                    <td>

                                        <div class="row-actions">

                                            <a
                                                href="/panel/servicios-tecnicos/visitas/<%= visita.visita_id %>"
                                                class="btn btn-small btn-success"
                                                title="Ver detalle"
                                            >
                                                Ver
                                            </a>

                                            <a
                                                href="/panel/servicios-tecnicos/visitas/<%= visita.visita_id %>/editar"
                                                class="btn btn-small"
                                                title="Editar visita"
                                            >
                                                Editar
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } else { %>

                <div class="empty-state">

                    <div class="empty-icon">📅</div>

                    <h3>No se encontraron visitas</h3>

                    <p>
                        No hay visitas que coincidan con los filtros seleccionados.
                        Podés modificar la búsqueda o registrar una nueva visita.
                    </p>

                    <a
                        href="/panel/servicios-tecnicos/visitas/nueva"
                        class="btn btn-primary"
                    >
                        + Registrar primera visita
                    </a>

                </div>

            <% } %>

        </div>

    </section>


    <footer class="footer">
        Servicios Técnicos · AppCraft Pro
        <br>
        Gestión y seguimiento de órdenes de trabajo
    </footer>

</div>


<script>
    // =========================================
    // MODO OSCURO / CLARO
    // =========================================

    const themeToggle = document.getElementById("themeToggle");

    function aplicarTema(tema) {

        document.documentElement.setAttribute(
            "data-theme",
            tema
        );

        localStorage.setItem("serviciosTema", tema);

        themeToggle.textContent =
            tema === "dark" ? "☀️" : "🌙";
    }

    const temaGuardado =
        localStorage.getItem("serviciosTema") || "dark";

    aplicarTema(temaGuardado);

    themeToggle.addEventListener("click", () => {

        const actual =
            document.documentElement.getAttribute("data-theme");

        aplicarTema(
            actual === "dark" ? "light" : "dark"
        );

    });
</script>

</body>
</html>