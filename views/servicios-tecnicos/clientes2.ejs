<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Servicios Técnicos | AppCraft</title>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #1f2937;
        }


        /* =========================
           HEADER
        ========================= */

        .topbar {

            height: 70px;

            background: #ffffff;

            border-bottom:
                1px solid #e5e7eb;

            display: flex;

            align-items: center;

            justify-content:
                space-between;

            padding:
                0 30px;

            position: sticky;

            top: 0;

            z-index: 10;

        }


        .brand {

            display: flex;

            align-items: center;

            gap: 12px;

        }


        .brand-icon {

            width: 42px;

            height: 42px;

            border-radius: 12px;

            background: #ea580c;

            color: white;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 20px;

        }


        .brand h1 {

            margin: 0;

            font-size: 19px;

        }


        .brand span {

            display: block;

            color: #6b7280;

            font-size: 12px;

            margin-top: 3px;

        }


        .user-info {

            color: #6b7280;

            font-size: 14px;

        }


        /* =========================
           CONTENIDO
        ========================= */

        .container {

            max-width: 1400px;

            margin: auto;

            padding: 30px;

        }


        .page-header {

            display: flex;

            justify-content:
                space-between;

            align-items:
                center;

            gap: 20px;

            margin-bottom:
                30px;

        }


        .page-header h2 {

            margin: 0;

            font-size: 28px;

        }


        .page-header p {

            margin:
                6px 0 0;

            color: #6b7280;

        }


        .actions {

            display: flex;

            gap: 10px;

        }


        .btn {

            border: none;

            text-decoration: none;

            padding:
                12px 18px;

            border-radius:
                10px;

            cursor: pointer;

            font-weight: 600;

            display: inline-flex;

            align-items: center;

            gap: 8px;

        }


        .btn-primary {

            background: #ea580c;

            color: white;

        }


        .btn-secondary {

            background: white;

            color: #374151;

            border:
                1px solid #d1d5db;

        }


        /* =========================
           ESTADÍSTICAS
        ========================= */

        .stats-grid {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 20px;

            margin-bottom:
                25px;

        }


        .stat-card {

            background: white;

            padding: 22px;

            border-radius:
                16px;

            border:
                1px solid #e5e7eb;

        }


        .stat-top {

            display: flex;

            justify-content:
                space-between;

            align-items:
                center;

        }


        .stat-label {

            color: #6b7280;

            font-size: 14px;

        }


        .stat-icon {

            width: 42px;

            height: 42px;

            border-radius: 12px;

            background: #fff1e8;

            color: #ea580c;

            display: flex;

            align-items: center;

            justify-content: center;

        }


        .stat-value {

            font-size: 28px;

            font-weight: bold;

            margin-top: 18px;

        }


        /* =========================
           GRID PRINCIPAL
        ========================= */

        .dashboard-grid {

            display: grid;

            grid-template-columns:
                1.4fr 1fr;

            gap: 25px;

        }


        .panel {

            background: white;

            border:
                1px solid #e5e7eb;

            border-radius:
                16px;

            overflow: hidden;

        }


        .panel-header {

            padding:
                20px;

            display: flex;

            align-items:
                center;

            justify-content:
                space-between;

            border-bottom:
                1px solid #f0f0f0;

        }


        .panel-header h3 {

            margin: 0;

        }


        .panel-body {

            padding:
                10px 20px 20px;

        }


        /* =========================
           TRABAJOS
        ========================= */

        .job {

            padding:
                16px 0;

            border-bottom:
                1px solid #f1f1f1;

        }


        .job:last-child {

            border-bottom:
                none;

        }


        .job-title {

            font-weight: 600;

        }


        .job-meta {

            color: #6b7280;

            font-size: 13px;

            margin-top: 5px;

        }


        .status {

            display: inline-block;

            margin-top: 8px;

            padding:
                5px 9px;

            border-radius:
                20px;

            background:
                #fef3c7;

            color:
                #92400e;

            font-size:
                12px;

            font-weight:
                600;

        }


        .empty {

            padding:
                35px 10px;

            text-align:
                center;

            color:
                #9ca3af;

        }


        /* =========================
           ACCESOS RÁPIDOS
        ========================= */

        .quick-actions {

            display: grid;

            gap: 12px;

        }


        .quick-action {

            text-decoration:
                none;

            color:
                #374151;

            border:
                1px solid #e5e7eb;

            padding:
                15px;

            border-radius:
                12px;

            display:
                flex;

            align-items:
                center;

            gap:
                14px;

            transition:
                .2s;

        }


        .quick-action:hover {

            border-color:
                #ea580c;

            transform:
                translateY(-2px);

        }


        .quick-icon {

            width:
                42px;

            height:
                42px;

            background:
                #fff1e8;

            color:
                #ea580c;

            border-radius:
                10px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media(max-width: 1000px) {

            .stats-grid {

                grid-template-columns:
                    repeat(2, 1fr);

            }


            .dashboard-grid {

                grid-template-columns:
                    1fr;

            }

        }


        @media(max-width: 600px) {

            .topbar {

                padding:
                    0 15px;

            }


            .user-info {

                display:
                    none;

            }


            .container {

                padding:
                    18px;

            }


            .page-header {

                align-items:
                    flex-start;

                flex-direction:
                    column;

            }


            .actions {

                width:
                    100%;

            }


            .actions .btn {

                flex:
                    1;

                justify-content:
                    center;

            }


            .stats-grid {

                grid-template-columns:
                    1fr;

            }

        }

    </style>

</head>


<body>


<!-- HEADER -->

<header class="topbar">

    <div class="brand">

        <div class="brand-icon">

            <i class="fas fa-screwdriver-wrench"></i>

        </div>


        <div>

            <h1>Servicios Técnicos</h1>

            <span>AppCraft Pro</span>

        </div>

    </div>


    <div class="user-info">

        <strong><%= username %></strong>
        ·
        <%= role %>

    </div>

</header>


<!-- CONTENIDO -->

<div class="container">


    <div class="page-header">

        <div>

            <h2>Panel de trabajo 🔧</h2>

            <p>
                Gestioná clientes, reparaciones,
                instalaciones y servicios.
            </p>

        </div>


        <div class="actions">

            <a
                href="/panel"
                class="btn btn-secondary"
            >

                <i class="fas fa-arrow-left"></i>

                Panel

            </a>


            <a
                href="/panel/servicios-tecnicos/ordenes/nueva"
                class="btn btn-primary"
            >

                <i class="fas fa-plus"></i>

                Nueva orden

            </a>

        </div>

    </div>


    <!-- ESTADÍSTICAS -->

    <div class="stats-grid">


        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-label">
                    Clientes activos
                </div>


                <div class="stat-icon">

                    <i class="fas fa-users"></i>

                </div>

            </div>


            <div class="stat-value">

                <%= stats.clientes %>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-label">
                    Trabajos pendientes
                </div>


                <div class="stat-icon">

                    <i class="fas fa-screwdriver-wrench"></i>

                </div>

            </div>


            <div class="stat-value">

                <%= stats.pendientes %>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-label">
                    Trabajos terminados
                </div>


                <div class="stat-icon">

                    <i class="fas fa-circle-check"></i>

                </div>

            </div>


            <div class="stat-value">

                <%= stats.terminados %>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-label">
                    Cobrado
                </div>


                <div class="stat-icon">

                    <i class="fas fa-dollar-sign"></i>

                </div>

            </div>


            <div class="stat-value">

                $<%= Number(stats.facturacion).toLocaleString("es-AR") %>

            </div>

        </div>


    </div>


    <!-- CONTENIDO -->

    <div class="dashboard-grid">


        <!-- PRÓXIMOS TRABAJOS -->

        <section class="panel">

            <div class="panel-header">

                <h3>
                    <i class="fas fa-calendar-days"></i>
                    Próximos trabajos
                </h3>


                <a
                    href="/panel/servicios-tecnicos/ordenes"
                    class="btn btn-secondary"
                >

                    Ver todos

                </a>

            </div>


            <div class="panel-body">


                <% if (proximosTrabajos.length === 0) { %>

                    <div class="empty">

                        <i
                            class="fas fa-calendar-xmark"
                            style="font-size:30px;"
                        ></i>

                        <p>
                            No hay trabajos pendientes.
                        </p>

                    </div>


                <% } %>



                <% proximosTrabajos.forEach(trabajo => { %>

                    <div class="job">

                        <div class="job-title">

                            <%= trabajo.cliente_nombre %>

                            ·

                            <%= trabajo.tipo_servicio %>

                        </div>


                        <div class="job-meta">

                            <i class="fas fa-phone"></i>

                            <%= trabajo.cliente_telefono || "Sin teléfono" %>

                        </div>


                        <span class="status">

                            <%= trabajo.estado %>

                        </span>

                    </div>

                <% }) %>


            </div>

        </section>



        <!-- ACCESOS -->

        <section class="panel">

            <div class="panel-header">

                <h3>
                    Accesos rápidos
                </h3>

            </div>


            <div class="panel-body">


                <div class="quick-actions">


                    <a
                        href="/panel/servicios-tecnicos/clientes"
                        class="quick-action"
                    >

                        <div class="quick-icon">

                            <i class="fas fa-users"></i>

                        </div>


                        <div>

                            <strong>
                                Clientes
                            </strong>

                            <br>

                            <small>
                                Ver y administrar clientes
                            </small>

                        </div>

                    </a>



                    <a
                        href="/panel/servicios-tecnicos/ordenes/nueva"
                        class="quick-action"
                    >

                        <div class="quick-icon">

                            <i class="fas fa-file-circle-plus"></i>

                        </div>


                        <div>

                            <strong>
                                Nueva orden
                            </strong>

                            <br>

                            <small>
                                Registrar una visita o reparación
                            </small>

                        </div>

                    </a>



                    <a
                        href="/panel/servicios-tecnicos/ordenes"
                        class="quick-action"
                    >

                        <div class="quick-icon">

                            <i class="fas fa-list-check"></i>

                        </div>


                        <div>

                            <strong>
                                Órdenes de trabajo
                            </strong>

                            <br>

                            <small>
                                Consultar el historial
                            </small>

                        </div>

                    </a>


                </div>


            </div>

        </section>


    </div>


</div>


</body>
</html>