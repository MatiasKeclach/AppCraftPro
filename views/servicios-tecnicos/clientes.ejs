<body>

<div class="layout">

```
<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">

    <div class="brand">

        <div class="brand-icon">
            <i class="fas fa-screwdriver-wrench"></i>
        </div>

        <div>
            <strong>Servicios Pro</strong>
            <small>AppCraft Platform</small>
        </div>

    </div>


    <nav class="nav">

        <div class="nav-title">GENERAL</div>

        <a href="/panel/servicios-tecnicos">
            <i class="fas fa-chart-pie"></i>
            Dashboard
        </a>


        <div class="nav-title">OPERACIÓN</div>

        <a
            class="active"
            href="/panel/servicios-tecnicos/clientes"
        >
            <i class="fas fa-users"></i>
            Clientes
        </a>

        <a href="/panel/servicios-tecnicos/ordenes">
            <i class="fas fa-clipboard-list"></i>
            Órdenes
        </a>

        <a href="/panel/servicios-tecnicos/ordenes/nueva">
            <i class="fas fa-plus-circle"></i>
            Nueva orden
        </a>


        <div class="nav-title">PRÓXIMAMENTE</div>

        <a href="javascript:void(0)">
            <i class="fas fa-calendar-days"></i>
            Agenda
            <span class="nav-badge">PRO</span>
        </a>

        <a href="javascript:void(0)">
            <i class="fas fa-file-invoice-dollar"></i>
            Presupuestos
        </a>


        <div class="nav-title">SISTEMA</div>

        <a href="/panel">
            <i class="fas fa-arrow-left"></i>
            AppCraft Pro
        </a>

    </nav>

</aside>


<!-- MAIN -->
<main class="main">

    <header class="topbar">

        <div class="page-title">

            <button
                class="btn btn-secondary menu-mobile"
                onclick="toggleMenu()"
            >
                <i class="fas fa-bars"></i>
            </button>

            <h1>Clientes</h1>

            <p>
                Gestioná tu cartera de clientes y sus servicios.
            </p>

        </div>


        <div class="top-actions">

            <button
                class="btn btn-secondary"
                onclick="toggleTheme()"
                title="Cambiar tema"
            >
                <i id="themeIcon" class="fas fa-moon"></i>
            </button>

            <button
                class="btn btn-primary"
                onclick="openModal()"
            >
                <i class="fas fa-user-plus"></i>
                Nuevo cliente
            </button>

        </div>

    </header>


    <!-- ESTADÍSTICAS -->
    <section class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>

            <div class="stat-label">
                Total de clientes
            </div>

            <div class="stat-value">
                <%= estadísticas.clientes %>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                <i class="fas fa-user-check"></i>
            </div>

            <div class="stat-label">
                Clientes activos
            </div>

            <div class="stat-value">
                <%= estadísticas.activos %>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                <i class="fas fa-user-clock"></i>
            </div>

            <div class="stat-label">
                Clientes inactivos
            </div>

            <div class="stat-value">
                <%= estadísticas.inactivos %>
            </div>

        </div>

    </section>


    <div class="toolbar">

        <div class="search">

            <i class="fas fa-search"></i>

            <input
                id="searchInput"
                type="text"
                placeholder="Buscar por nombre, teléfono, email o dirección..."
                oninput="filterClients()"
            >

        </div>

    </div>


    <div class="content-grid">

        <!-- TABLA CLIENTES -->
        <section class="card">

            <div class="card-header">

                <h3>
                    <i class="fas fa-address-book"></i>
                    Base de clientes
                </h3>

                <span class="count">
                    <%= clientes.length %> registrados
                </span>

            </div>


            <% if (clientes.length > 0) { %>

                <div class="table-wrapper">

                    <table id="clientsTable">

                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th class="hide-mobile">Teléfono</th>
                                <th class="hide-mobile">Dirección</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% clientes.forEach(cliente => { %>

                                <tr>

                                    <td>

                                        <div class="client">

                                            <div class="avatar">
                                                <i class="fas fa-user"></i>
                                            </div>

                                            <div>

                                                <div class="client-name">
                                                    <%= cliente.nombre %>
                                                </div>

                                                <div class="client-id">
                                                    Cliente #<%= cliente.id %>
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <td class="hide-mobile">

                                        <%= cliente.telefono || "—" %>

                                    </td>


                                    <td class="hide-mobile">

                                        <%= cliente.direccion || "—" %>

                                    </td>


                                    <td>

                                        <% if (cliente.estado === "inactivo") { %>

                                            <span
                                                style="
                                                    color:#d97706;
                                                    font-size:12px;
                                                    font-weight:600;
                                                "
                                            >
                                                ● Inactivo
                                            </span>

                                        <% } else { %>

                                            <span class="status">

                                                <span class="status-dot"></span>

                                                Activo

                                            </span>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>


            <% } else { %>

                <div class="empty">

                    <i class="fas fa-users"></i>

                    <h3>
                        Todavía no tenés clientes
                    </h3>

                    <p>
                        Agregá tu primer cliente para comenzar
                        a registrar servicios y órdenes de trabajo.
                    </p>

                    <button
                        class="btn btn-primary"
                        onclick="openModal()"
                    >
                        <i class="fas fa-plus"></i>
                        Agregar cliente
                    </button>

                </div>

            <% } %>

        </section>


        <!-- PRÓXIMOS TRABAJOS -->
        <aside class="card">

            <div class="card-header">

                <h3>
                    <i class="fas fa-calendar-check"></i>
                    Próximos trabajos
                </h3>

            </div>


            <% if (proximosTrabajos && proximosTrabajos.length > 0) { %>

                <div class="jobs-list">

                    <% proximosTrabajos.forEach(trabajo => { %>

                        <div class="job">

                            <div class="job-service">

                                <%= trabajo.tipo_servicio || "Servicio técnico" %>

                            </div>

                            <div class="job-client">

                                <%= trabajo.cliente_nombre %>

                            </div>

                            <div class="job-date">

                                <i class="fas fa-calendar"></i>

                                <%= trabajo.fecha_programada
                                    ? new Date(trabajo.fecha_programada)
                                        .toLocaleString("es-AR")
                                    : "Sin fecha programada"
                                %>

                            </div>

                        </div>

                    <% }) %>

                </div>


            <% } else { %>

                <div class="empty">

                    <i class="fas fa-calendar-check"></i>

                    <p>
                        No hay trabajos pendientes.
                    </p>

                </div>

            <% } %>

        </aside>

    </div>

</main>
```

