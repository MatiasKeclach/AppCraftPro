</div>

<script>

    // ==========================================
    // DARK MODE
    // ==========================================

    function updateThemeIcon() {

        const icon =
            document.getElementById("themeIcon");


        if (document.body.classList.contains("dark")) {

            icon.className =
                "fas fa-sun";

        } else {

            icon.className =
                "fas fa-moon";

        }

    }


    function toggleTheme() {

        document.body.classList.toggle("dark");


        localStorage.setItem(
            "services-theme",

            document.body.classList.contains("dark")
                ? "dark"
                : "light"
        );


        updateThemeIcon();

    }


    if (
        localStorage.getItem("services-theme") === "dark"
    ) {

        document.body.classList.add("dark");

    }


    updateThemeIcon();


    // ==========================================
    // MENÚ MOBILE
    // ==========================================

    function toggleMenu() {

        document
            .getElementById("sidebar")
            .classList
            .toggle("open");

    }


    // ==========================================
    // MODAL
    // ==========================================

    function openModal() {

        document
            .getElementById("clientModal")
            .classList
            .add("show");

    }


    function closeModal() {

        document
            .getElementById("clientModal")
            .classList
            .remove("show");

    }


    document
        .getElementById("clientModal")
        .addEventListener(
            "click",
            event => {

                if (
                    event.target.id ===
                    "clientModal"
                ) {

                    closeModal();

                }

            }
        );


    // ==========================================
    // BUSCADOR
    // ==========================================

    function filterClients() {

        const search =
            document
                .getElementById("searchInput")
                .value
                .toLowerCase();


        const rows =
            document.querySelectorAll(
                "#clientsTable tbody tr"
            );


        rows.forEach(
            row => {

                const text =
                    row.innerText
                        .toLowerCase();


                row.style.display =
                    text.includes(search)
                        ? ""
                        : "none";

            }
        );

    }


    // ==========================================
    // CREAR CLIENTE
    // ==========================================

    document
        .getElementById("clientForm")
        .addEventListener(
            "submit",
            async event => {

                event.preventDefault();


                const button =
                    document.getElementById(
                        "saveButton"
                    );


                const originalText =
                    button.innerHTML;


                button.disabled =
                    true;


                button.innerHTML =
                    '<i class="fas fa-spinner fa-spin"></i> Guardando...';


                const data =
                    Object.fromEntries(
                        new FormData(
                            event.target
                        )
                    );


                try {

                    const response =
                        await fetch(
                            "/panel/servicios-tecnicos/clientes/nuevo",
                            {
                                method:
                                    "POST",

                                headers: {

                                    "Content-Type":
                                        "application/json"

                                },

                                body:
                                    JSON.stringify(data)

                            }
                        );


                    const result =
                        await response.json();


                    if (result.success) {

                        window.location.reload();

                    } else {

                        alert(
                            result.error ||
                            "No se pudo guardar el cliente."
                        );

                    }

                }
                catch (error) {

                    console.error(
                        "Error:",
                        error
                    );


                    alert(
                        "Error de conexión con el servidor."
                    );

                }
                finally {

                    button.disabled =
                        false;


                    button.innerHTML =
                        originalText;

                }

            }
        );

</script>

</body>
</html>
