<title>Clientes | Servicios Técnicos</title>

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
>

<style>

    :root {
        --bg: #f4f7fb;
        --surface: #ffffff;
        --surface-soft: #f8fafc;
        --text: #172033;
        --muted: #718096;
        --border: #e5eaf1;
        --primary: #2563eb;
        --primary-soft: #eff6ff;
        --sidebar: #111827;
        --sidebar-hover: #1e293b;
        --success: #16a34a;
        --warning: #d97706;
        --shadow: 0 10px 35px rgba(15, 23, 42, .07);
    }

    body.dark {
        --bg: #09111f;
        --surface: #111827;
        --surface-soft: #182235;
        --text: #f1f5f9;
        --muted: #94a3b8;
        --border: #253044;
        --primary-soft: #172554;
        --sidebar: #070b14;
        --sidebar-hover: #172033;
        --shadow: 0 10px 35px rgba(0, 0, 0, .25);
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Inter, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        transition: background .25s, color .25s;
    }

    /* ===============================
       LAYOUT
    =============================== */

    .layout {
        min-height: 100vh;
    }

    /* ===============================
       SIDEBAR
    =============================== */

    .sidebar {
        width: 260px;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        background: var(--sidebar);
        color: white;
        padding: 20px 14px;
        z-index: 100;
        transition: transform .3s;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px;
        margin-bottom: 28px;
    }

    .brand-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        font-size: 18px;
    }

    .brand strong {
        display: block;
        font-size: 15px;
    }

    .brand small {
        display: block;
        color: #94a3b8;
        margin-top: 3px;
        font-size: 11px;
    }

    .nav-title {
        color: #64748b;
        font-size: 10px;
        font-weight: bold;
        letter-spacing: 1px;
        margin: 22px 12px 8px;
    }

    .nav a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        margin-bottom: 4px;
        border-radius: 10px;
        color: #94a3b8;
        text-decoration: none;
        transition: .2s;
        font-size: 14px;
    }

    .nav a:hover,
    .nav a.active {
        background: var(--sidebar-hover);
        color: white;
    }

    .nav a i {
        width: 20px;
        text-align: center;
    }

    .nav-badge {
        margin-left: auto;
        font-size: 9px;
        background: #2563eb;
        color: white;
        padding: 3px 7px;
        border-radius: 20px;
    }

    /* ===============================
       MAIN
    =============================== */

    .main {
        margin-left: 260px;
        padding: 30px;
        min-height: 100vh;
    }

    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
    }

    .page-title h1 {
        margin: 0;
        font-size: 27px;
        letter-spacing: -.5px;
    }

    .page-title p {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 14px;
    }

    .top-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ===============================
       BUTTONS
    =============================== */

    .btn {
        border: none;
        border-radius: 11px;
        padding: 11px 16px;
        font: inherit;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: .2s;
        text-decoration: none;
    }

    .btn:hover {
        transform: translateY(-1px);
    }

    .btn-primary {
        background: var(--primary);
        color: white;
        box-shadow: 0 6px 18px rgba(37, 99, 235, .2);
    }

    .btn-secondary {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
    }

    .menu-mobile {
        display: none;
    }

    /* ===============================
       STATS
    =============================== */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 17px;
        padding: 20px;
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
    }

    .stat-card::after {
        content: "";
        position: absolute;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: var(--primary-soft);
        right: -30px;
        top: -30px;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: var(--primary-soft);
        color: var(--primary);
        margin-bottom: 14px;
    }

    .stat-label {
        color: var(--muted);
        font-size: 13px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        margin-top: 5px;
    }

    /* ===============================
       SEARCH
    =============================== */

    .toolbar {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 14px;
        box-shadow: var(--shadow);
        margin-bottom: 20px;
    }

    .search {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 0 13px;
    }

    .search i {
        color: var(--muted);
    }

    .search input {
        width: 100%;
        border: none;
        outline: none;
        padding: 13px 0;
        background: transparent;
        color: var(--text);
        font: inherit;
    }

    /* ===============================
       CONTENT GRID
    =============================== */

    .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 20px;
    }

    .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 17px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .card-header {
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border);
    }

    .card-header h3 {
        margin: 0;
        font-size: 15px;
    }

    .count {
        color: var(--muted);
        font-size: 12px;
    }

    /* ===============================
       TABLE
    =============================== */

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        padding: 13px 20px;
        color: var(--muted);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .6px;
        background: var(--surface-soft);
    }

    td {
        padding: 15px 20px;
        border-top: 1px solid var(--border);
        font-size: 14px;
    }

    .client {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .avatar {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: var(--primary-soft);
        color: var(--primary);
    }

    .client-name {
        font-weight: 600;
    }

    .client-id {
        color: var(--muted);
        font-size: 11px;
        margin-top: 3px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--success);
        font-size: 12px;
        font-weight: 600;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
    }

    /* ===============================
       UPCOMING WORK
    =============================== */

    .jobs-list {
        padding: 8px;
    }

    .job {
        padding: 14px;
        border-bottom: 1px solid var(--border);
    }

    .job:last-child {
        border-bottom: none;
    }

    .job-service {
        font-size: 12px;
        color: var(--primary);
        font-weight: 600;
    }

    .job-client {
        font-weight: 600;
        margin: 5px 0;
        font-size: 14px;
    }

    .job-date {
        color: var(--muted);
        font-size: 11px;
    }

    .empty {
        padding: 50px 20px;
        text-align: center;
        color: var(--muted);
    }

    .empty i {
        font-size: 40px;
        color: var(--primary);
        margin-bottom: 12px;
    }

    /* ===============================
       MODAL
    =============================== */

    .modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 500;
        background: rgba(15, 23, 42, .65);
        align-items: center;
        justify-content: center;
        padding: 20px;
        backdrop-filter: blur(4px);
    }

    .modal.show {
        display: flex;
    }

    .modal-box {
        width: min(680px, 100%);
        max-height: 90vh;
        overflow-y: auto;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: 0 25px 80px rgba(0,0,0,.3);
    }

    .modal-head {
        padding: 22px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .modal-head h2 {
        margin: 0;
        font-size: 20px;
    }

    .modal-head p {
        color: var(--muted);
        margin: 6px 0 0;
        font-size: 13px;
    }

    .modal-content {
        padding: 24px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .field.full {
        grid-column: 1 / -1;
    }

    label {
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    input,
    textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface-soft);
        color: var(--text);
        padding: 12px;
        font: inherit;
        outline: none;
        transition: border .2s;
    }

    input:focus,
    textarea:focus {
        border-color: var(--primary);
    }

    textarea {
        min-height: 90px;
        resize: vertical;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 18px 24px;
        border-top: 1px solid var(--border);
    }

    /* ===============================
       MOBILE
    =============================== */

    @media (max-width: 1050px) {

        .content-grid {
            grid-template-columns: 1fr;
        }

    }

    @media (max-width: 800px) {

        .sidebar {
            transform: translateX(-100%);
            box-shadow: 15px 0 40px rgba(0,0,0,.25);
        }

        .sidebar.open {
            transform: translateX(0);
        }

        .main {
            margin-left: 0;
            padding: 18px;
        }

        .menu-mobile {
            display: inline-flex;
        }

        .topbar {
            align-items: flex-start;
        }

        .page-title h1 {
            font-size: 23px;
        }

        .hide-mobile {
            display: none;
        }

    }

    @media (max-width: 600px) {

        .topbar {
            flex-direction: column;
            gap: 16px;
        }

        .top-actions {
            width: 100%;
        }

        .top-actions .btn-primary {
            flex: 1;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .field.full {
            grid-column: auto;
        }

    }

</style>
```

