<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Órdenes | Servicios Pro</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
:root{--bg:#f5f7fb;--card:#fff;--text:#172033;--muted:#718096;--border:#e7ebf2;--primary:#2563eb;--sidebar:#111827}
body.dark{--bg:#0b1120;--card:#111827;--text:#f1f5f9;--muted:#94a3b8;--border:#243044;--sidebar:#070b14}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:var(--text)}
.sidebar{width:250px;background:var(--sidebar);height:100vh;position:fixed;color:white;padding:22px 15px}
.brand{font-size:19px;font-weight:bold;padding:10px;margin-bottom:25px}
.brand span{font-size:11px;color:#94a3b8;display:block;margin-top:4px}
.nav a{display:flex;gap:12px;color:#94a3b8;text-decoration:none;padding:12px;border-radius:9px;margin:3px 0}
.nav a:hover,.nav .active{background:#1e293b;color:#fff}
.label{font-size:10px;color:#64748b;margin:20px 10px 8px;font-weight:bold}
.main{margin-left:250px;padding:30px}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}
h1{margin:0;font-size:27px} .sub{color:var(--muted);margin-top:6px}
.btn{border:0;border-radius:10px;padding:12px 16px;text-decoration:none;display:inline-flex;gap:8px;align-items:center;cursor:pointer;font-weight:bold}
.primary{background:var(--primary);color:white}.secondary{background:var(--card);border:1px solid var(--border);color:var(--text)}
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.head{padding:18px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between}
table{width:100%;border-collapse:collapse}th{text-align:left;padding:14px 20px;background:rgba(128,128,128,.04);font-size:11px;color:var(--muted);text-transform:uppercase}td{padding:17px 20px;border-top:1px solid var(--border)}
.badge{padding:6px 10px;border-radius:20px;font-size:12px;font-weight:bold;background:#fef3c7;color:#92400e}
.done{background:#dcfce7;color:#166534}.cancel{background:#fee2e2;color:#991b1b}
.empty{text-align:center;padding:70px 20px;color:var(--muted)}.empty i{font-size:50px;color:var(--primary)}
.theme{margin-right:10px}
@media(max-width:750px){.sidebar{display:none}.main{margin:0;padding:18px}.hide{display:none}.top{align-items:flex-start;gap:15px}.top>div:last-child{display:flex;flex-direction:column}.btn{justify-content:center}}
</style>
</head>
<body>

<aside class="sidebar">
  <div class="brand">🔧 Servicios Pro <span>AppCraft Platform</span></div>
  <div class="nav">
    <div class="label">GENERAL</div>
    <a href="/panel/servicios-tecnicos"><i class="fas fa-grid-2"></i> Dashboard</a>
    <div class="label">OPERACIÓN</div>
    <a href="/panel/servicios-tecnicos/clientes"><i class="fas fa-users"></i> Clientes</a>
    <a class="active" href="/panel/servicios-tecnicos/ordenes"><i class="fas fa-clipboard-list"></i> Órdenes</a>
    <a href="/panel/servicios-tecnicos/visitas"><i class="fas fa-calendar"></i> Agenda</a>
    <a href="#"><i class="fas fa-file-invoice"></i> Presupuestos</a>
    <div class="label">ADMINISTRACIÓN</div>
    <a href="#"><i class="fas fa-wallet"></i> Caja</a>
    <a href="#"><i class="fas fa-box"></i> Inventario</a>
    <div class="label">SISTEMA</div>
    <a href="/panel"><i class="fas fa-arrow-left"></i> AppCraft Pro</a>
  </div>
</aside>

<main class="main">
<div class="top">
  <div>
    <h1>Órdenes de trabajo</h1>
    <div class="sub">Controlá todas las visitas, reparaciones e instalaciones.</div>
  </div>
  <div>
    <button class="btn secondary theme" onclick="theme()">🌙</button>
    <a class="btn primary" href="/panel/servicios-tecnicos/ordenes/nueva">
      <i class="fas fa-plus"></i> Nueva orden
    </a>
  </div>
</div>

<div class="card">
<div class="head">
  <strong>Historial de órdenes</strong>
  <span style="color:var(--muted)"><%= ordenes.length %> registradas</span>
</div>

<% if(ordenes.length === 0){ %>
<div class="empty">
  <i class="fas fa-clipboard-list"></i>
  <h3>Todavía no hay órdenes</h3>
  <p>Creá la primera orden de trabajo para comenzar.</p>
  <a class="btn primary" href="/panel/servicios-tecnicos/ordenes/nueva">Crear orden</a>
</div>
<% } else { %>
<div style="overflow:auto">
<table>
<thead><tr><th>#</th><th>Cliente</th><th>Servicio</th><th class="hide">Equipo</th><th>Estado</th><th class="hide">Total</th></tr></thead>
<tbody>
<% ordenes.forEach(o => { %>
<tr>
<td>#<%= o.id %></td>
<td><strong><%= o.cliente_nombre %></strong><br><small style="color:var(--muted)"><%= o.cliente_telefono || "" %></small></td>
<td><%= o.tipo_servicio %></td>
<td class="hide"><%= o.equipo || "—" %></td>
<td>
<span class="badge <%= o.estado === 'terminado' ? 'done' : o.estado === 'cancelado' ? 'cancel' : '' %>">
<%= o.estado %>
</span>
</td>
<td class="hide">$<%= Number(o.total || 0).toLocaleString("es-AR") %></td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } %>
</div>
</main>

<script>
function theme(){
 document.body.classList.toggle("dark");
 localStorage.setItem("services-theme",document.body.classList.contains("dark")?"dark":"light");
}
if(localStorage.getItem("services-theme")==="dark")document.body.classList.add("dark");
</script>
</body>
</html>