            </tbody>

          </table>

        </div>

      `;

    }


    /* =========================================================
       CONSULTAS
    ========================================================= */

    function prepararConsultas() {

      const clientesSelect =
        document.getElementById(
          "consultaCliente"
        );


      const choferSelect =
        document.getElementById(
          "consultaChofer"
        );


      const clienteActual =
        clientesSelect?.value || "";


      const choferActual =
        choferSelect?.value || "";


      if (clientesSelect) {

        clientesSelect.innerHTML = `

          <option value="">
            Todos
          </option>

        `;


        clientes.forEach(c => {

          const option =
            document.createElement(
              "option"
            );


          option.value =
            c.id;


          option.textContent =
            obtenerNombreCliente(c);


          clientesSelect.appendChild(
            option
          );

        });


        if (
          clienteActual &&
          clientes.some(
            c =>
              String(c.id) ===
              String(clienteActual)
          )
        ) {

          clientesSelect.value =
            clienteActual;

        }

      }


      if (choferSelect) {

        choferSelect.innerHTML = `

          <option value="">
            Todos
          </option>

        `;


        choferes.forEach(c => {

          const option =
            document.createElement(
              "option"
            );


          option.value =
            c.id;


          option.textContent =
            obtenerNombreChofer(c);


          choferSelect.appendChild(
            option
          );

        });


        if (
          choferActual &&
          choferes.some(
            c =>
              String(c.id) ===
              String(choferActual)
          )
        ) {

          choferSelect.value =
            choferActual;

        }

      }

    }


    function ejecutarConsulta() {

      const texto =
        String(
          document.getElementById(
            "consultaTexto"
          )?.value || ""
        )
        .toLowerCase()
        .trim();


      const tipo =
        document.getElementById(
          "consultaTipo"
        )?.value || "";


      const cliente =
        document.getElementById(
          "consultaCliente"
        )?.value || "";


      const chofer =
        document.getElementById(
          "consultaChofer"
        )?.value || "";


      const fecha =
        document.getElementById(
          "consultaFecha"
        )?.value || "";


      const resultado =
        paquetes.filter(p => {

          const contenido = [

            p.codigo,
            p.codigo_interno,
            p.codigo_externo,
            p.tracking_number,
            p.destinatario,
            p.dni,
            p.telefono,
            p.direccion,
            p.barrio,
            p.localidad,
            p.zona,
            p.referencia,
            p.remitente

          ]
          .filter(
            valor =>
              valor !== null &&
              valor !== undefined
          )
          .join(" ")
          .toLowerCase();


          const coincideTexto =
            !texto ||
            contenido.includes(texto);


          const coincideTipo =
            !tipo ||
            String(p.tipo || "").toUpperCase() ===
            String(tipo).toUpperCase();


          const coincideCliente =
            !cliente ||
            String(
              p.cliente_id ?? ""
            ) === String(cliente);


          const coincideChofer =
            !chofer ||
            String(
              p.chofer_id ?? ""
            ) === String(chofer);


          const coincideFecha =
            !fecha ||
            obtenerFechaCampo(p) === fecha;


          return (
            coincideTexto &&
            coincideTipo &&
            coincideCliente &&
            coincideChofer &&
            coincideFecha
          );

        });


      const div =
        document.getElementById(
          "resultadosConsulta"
        );


      if (!div) {
        return;
      }


      if (!resultado.length) {

        div.innerHTML = `

          <div class="empty">

            <i class="fas fa-search"></i>

            <p>
              No se encontraron resultados.
            </p>

          </div>

        `;

        return;

      }


      div.innerHTML =
        resultado
          .map(crearTarjetaPaquete)
          .join("");

    }


    /* =========================================================
       PROCESAR COLECTA
    ========================================================= */

    async function procesarColecta() {

      const fecha =
        document.getElementById(
          "nuevaFecha"
        ).value;


      const cliente =
        document.getElementById(
          "nuevoCliente"
        ).value;


      const inputFotos =
        document.getElementById(
          "nuevasFotos"
        );


      const archivos =
        inputFotos?.files || [];


      if (!fecha) {

        alert(
          "Seleccioná la fecha."
        );

        return;

      }


      if (!cliente) {

        alert(
          "Seleccioná un cliente."
        );

        return;

      }


      if (!archivos.length) {

        alert(
          "Seleccioná al menos una fotografía."
        );

        return;

      }


      const boton =
        document.getElementById(
          "btnProcesar"
        );


      const progress =
        document.getElementById(
          "progressBox"
        );


      const text =
        document.getElementById(
          "progressText"
        );


      const bar =
        document.getElementById(
          "progressBar"
        );


      boton.disabled = true;

      progress.style.display =
        "block";


      try {

        text.textContent =
          `Preparando ${archivos.length} fotografía(s)...`;

        bar.style.width =
          "5%";


        const formData =
          new FormData();


        formData.append(
          "fecha",
          fecha
        );


        formData.append(
          "cliente_id",
          cliente
        );


        for (
          let i = 0;
          i < archivos.length;
          i++
        ) {

          text.textContent =
            `Preparando ${i + 1} de ${archivos.length}: ${archivos[i].name}`;


          bar.style.width =
            `${Math.round(
              ((i + 1) /
                archivos.length) *
              40
            )}%`;


          formData.append(
            "fotos",
            archivos[i]
          );

        }


        text.textContent =
          "Enviando fotografías al servidor...";


        bar.style.width =
          "50%";


        const respuesta =
          await fetch(
            "/panel/logistica/deposito/api/colectas",
            {
              method: "POST",
              body: formData
            }
          );


        const texto =
          await respuesta.text();


        let datos = {};


        try {

          datos =
            texto
              ? JSON.parse(texto)
              : {};

        }
        catch (error) {

          console.error(
            "Respuesta del servidor:",
            texto
          );

          throw new Error(
            "El servidor no devolvió JSON válido."
          );

        }


        if (
          !respuesta.ok ||
          datos.ok === false
        ) {

          throw new Error(
            datos.mensaje ||
            datos.error ||
            `Error HTTP ${respuesta.status}`
          );

        }


        bar.style.width =
          "90%";


        text.textContent =
          "Actualizando información del depósito...";


        await cargarTodo();


        bar.style.width =
          "100%";


        text.textContent =
          "Colecta procesada correctamente.";


        inputFotos.value =
          "";


        alert(
          "✅ Colecta cargada correctamente."
        );

      }
      catch (error) {

        console.error(
          "Error procesando colecta:",
          error
        );


        text.textContent =
          "Error durante el procesamiento.";


        alert(
          "❌ Error procesando colecta:\n\n" +
          error.message
        );

      }
      finally {

        boton.disabled = false;


        setTimeout(() => {

          progress.style.display =
            "none";


          bar.style.width =
            "0%";


          text.textContent =
            "Preparando...";

        }, 1200);

      }

    }


    /* =========================================================
       TECLADO / MODALES
    ========================================================= */

    document.addEventListener(
      "keydown",
      event => {

        if (
          event.key !== "Escape"
        ) {

          return;

        }


        cerrarModal(
          "modalPaquete"
        );


        cerrarModal(
          "modalFoto"
        );

      }
    );


    /* =========================================================
       INICIO
    ========================================================= */

    document.addEventListener(
      "DOMContentLoaded",
      async () => {

        const hoy =
          new Date()
            .toISOString()
            .substring(0, 10);


        const fecha =
          document.getElementById(
            "nuevaFecha"
          );


        if (fecha) {

          fecha.value =
            hoy;

        }


        await cargarTodo();

      }
    );

  </script>

</body>
</html>
