  <script>

    /* =========================================================
       ESTADO GLOBAL
    ========================================================= */

    let paquetes = [];
    let colectas = [];
    let clientes = [];
    let choferes = [];

    let fotoActual = "";

    let cargandoDatos = false;


    /* =========================================================
       UTILIDADES
    ========================================================= */

    function escapar(valor) {

      if (
        valor === null ||
        valor === undefined
      ) {
        return "";
      }

      return String(valor)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }


    function escaparJS(valor) {

      return String(valor || "")
        .replace(/\\/g, "\\\\")
        .replace(/'/g, "\\'")
        .replace(/\n/g, "\\n")
        .replace(/\r/g, "");
    }


    function valorSeguro(valor, defecto = "") {

      if (
        valor === null ||
        valor === undefined ||
        valor === ""
      ) {
        return defecto;
      }

      return valor;
    }


    function obtenerFechaCampo(objeto) {

      if (!objeto) {
        return "";
      }

      return String(
        objeto.fecha ||
        objeto.fecha_recepcion ||
        objeto.fecha_importacion ||
        objeto.created_at ||
        ""
      ).substring(0, 10);
    }


    function obtenerNombreCliente(cliente) {

      if (!cliente) {
        return "Sin cliente";
      }

      return (
        cliente.nombre ||
        cliente.empresa ||
        cliente.razon_social ||
        "Cliente"
      );
    }


    function obtenerNombreChofer(chofer) {

      if (!chofer) {
        return "Sin asignar";
      }

      return (
        chofer.nombre ||
        chofer.apellido ||
        "Chofer"
      );
    }


    /* =========================================================
       API
    ========================================================= */

    async function api(url, options = {}) {

      const configuracion = {
        ...options,
        headers: {
          ...(options.headers || {})
        }
      };


      /*
       * IMPORTANTE:
       *
       * No agregar Content-Type automáticamente.
       *
       * Si usamos FormData, el navegador necesita
       * establecer automáticamente multipart/form-data
       * con su boundary.
       */

      if (
        configuracion.body &&
        !(configuracion.body instanceof FormData)
      ) {

        configuracion.headers["Content-Type"] =
          "application/json";
      }


      const respuesta =
        await fetch(url, configuracion);


      const texto =
        await respuesta.text();


      let datos = {};


      if (texto) {

        try {

          datos = JSON.parse(texto);

        }
        catch (error) {

          console.error(
            "Respuesta no JSON:",
            texto
          );

          throw new Error(
            "El servidor no devolvió JSON válido."
          );
        }
      }


      if (
        !respuesta.ok ||
        datos.ok === false
      ) {

        throw new Error(
          datos.mensaje ||
          datos.error ||
          datos.message ||
          `Error HTTP ${respuesta.status}`
        );
      }


      return datos;
    }


    /* =========================================================
       NAVEGACIÓN
    ========================================================= */

    function mostrarSeccion(id, boton = null) {

      document
        .querySelectorAll(".section")
        .forEach(section => {

          section.classList.remove("active");

        });


      document
        .querySelectorAll(".nav button")
        .forEach(btn => {

          btn.classList.remove("active");

        });


      const section =
        document.getElementById(id);


      if (!section) {
        return;
      }


      section.classList.add("active");


      if (boton) {

        boton.classList.add("active");

      }


      switch (id) {

        case "dashboard":

          actualizarDashboard();

          break;


        case "colectas":

          listarColectas();

          break;


        case "paquetes":

          listarPaquetes();

          break;


        case "clientes":

          listarClientes();

          break;


        case "choferes":

          listarChoferes();

          break;


        case "consultas":

          prepararConsultas();

          break;

      }

    }


    /* =========================================================
       CARGAR TODO
    ========================================================= */

    async function cargarTodo() {

      if (cargandoDatos) {
        return;
      }


      cargandoDatos = true;


      try {

        const datos =
          await api(
            "/panel/logistica/deposito/api/datos"
          );


        paquetes =
          Array.isArray(datos.paquetes)
            ? datos.paquetes
            : [];


        colectas =
          Array.isArray(datos.colectas)
            ? datos.colectas
            : [];


        clientes =
          Array.isArray(datos.clientes)
            ? datos.clientes
            : [];


        choferes =
          Array.isArray(datos.choferes)
            ? datos.choferes
            : [];


        actualizarDashboard();

        cargarClientesSelect();

        cargarChoferesSelect();

        prepararConsultas();

        listarColectas();

        listarPaquetes();

        listarClientes();

        listarChoferes();

      }
      catch (error) {

        console.error(
          "Error cargando datos:",
          error
        );


        mostrarErrorDashboard(
          error.message
        );

      }
      finally {

        cargandoDatos = false;

      }

    }


    /* =========================================================
       DASHBOARD
    ========================================================= */

    function actualizarDashboard() {

      const total =
        paquetes.length;


      const flex =
        paquetes.filter(
          p => String(p.tipo).toUpperCase() === "FLEX"
        ).length;


      const particular =
        paquetes.filter(
          p => String(p.tipo).toUpperCase() === "PARTICULAR"
        ).length;


      const revisar =
        paquetes.filter(
          p => String(p.tipo).toUpperCase() === "REVISAR"
        ).length;


      const pendientes =
        paquetes.filter(p => {

          const estado =
            String(
              p.estado || "Pendiente"
            ).toLowerCase();


          return (
            estado === "pendiente" ||
            estado === "en depósito".toLowerCase()
          );

        }).length;


      actualizarTexto(
        "statTotal",
        total
      );

      actualizarTexto(
        "statFlex",
        flex
      );

      actualizarTexto(
        "statParticular",
        particular
      );

      actualizarTexto(
        "statRevision",
        revisar
      );

      actualizarTexto(
        "statColectas",
        colectas.length
      );

      actualizarTexto(
        "statPendientes",
        pendientes
      );


      renderDashboardColectas();

    }


    function actualizarTexto(id, valor) {

      const elemento =
        document.getElementById(id);


      if (elemento) {

        elemento.textContent =
          String(valor);

      }

    }


    function mostrarErrorDashboard(mensaje) {

      const div =
        document.getElementById(
          "dashboardColectas"
        );


      if (!div) {
        return;
      }


      div.innerHTML = `

        <div class="empty">

          <i class="fas fa-triangle-exclamation"></i>

          <p>
            No se pudieron cargar los datos.
          </p>

          <small>
            ${escapar(mensaje)}
          </small>

        </div>

      `;

    }


    function renderDashboardColectas() {

      const div =
        document.getElementById(
          "dashboardColectas"
        );


      if (!div) {
        return;
      }


      if (!colectas.length) {

        div.innerHTML = `

          <div class="empty">

            <i class="fas fa-truck-loading"></i>

            <p>
              No hay colectas registradas.
            </p>

          </div>

        `;

        return;
      }


      const ultimas =
        colectas
          .slice()
          .sort((a, b) => {

            const da =
              new Date(
                a.created_at ||
                a.fecha_recepcion ||
                a.fecha ||
                0
              ).getTime();


            const db =
              new Date(
                b.created_at ||
                b.fecha_recepcion ||
                b.fecha ||
                0
              ).getTime();


            return db - da;

          })
          .slice(0, 8);


      div.innerHTML =
        ultimas.map(c => {

          const cliente =
            c.cliente_nombre ||
            c.cliente ||
            obtenerNombreCliente(
              clientes.find(
                x =>
                  String(x.id) ===
                  String(c.cliente_id)
              )
            );


          return `

            <div style="
              padding:13px;
              border-bottom:1px solid #e2e8f0;
            ">

              <strong>
                Colecta #${escapar(c.id)}
              </strong>

              <br>

              <span style="
                color:#64748b;
                font-size:12px;
              ">

                ${escapar(cliente)}

                &nbsp; · &nbsp;

                ${escapar(
                  obtenerFechaCampo(c)
                )}

              </span>

              <br>

              <span
                class="badge badge-recibida"
                style="margin-top:6px;"
              >

                ${escapar(
                  c.estado || "Recibida"
                )}

              </span>

            </div>

          `;

        }).join("");

    }


    /* =========================================================
       COLECTAS
    ========================================================= */

    function listarColectas() {

      const div =
        document.getElementById(
          "listaColectas"
        );


      if (!div) {
        return;
      }


      const input =
        document.getElementById(
          "buscarColecta"
        );


      const fechaInput =
        document.getElementById(
          "fechaFiltro"
        );


      const texto =
        String(
          input?.value || ""
        )
        .toLowerCase()
        .trim();


      const fecha =
        fechaInput?.value || "";


      const lista =
        colectas.filter(c => {

          const cliente =
            String(
              c.cliente_nombre ||
              c.cliente ||
              obtenerNombreCliente(
                clientes.find(
                  x =>
                    String(x.id) ===
                    String(c.cliente_id)
                )
              ) ||
              ""
            ).toLowerCase();


          const id =
            String(c.id || "")
              .toLowerCase();


          const coincideTexto =
            !texto ||
            cliente.includes(texto) ||
            id.includes(texto);


          const coincideFecha =
            !fecha ||
            obtenerFechaCampo(c) === fecha;


          return (
            coincideTexto &&
            coincideFecha
          );

        });


      if (!lista.length) {

        div.innerHTML = `

          <div class="card empty">

            <i class="fas fa-inbox"></i>

            <p>
              No se encontraron colectas.
            </p>

          </div>

        `;

        return;

      }


      const ordenadas =
        lista
          .slice()
          .reverse();


      div.innerHTML =
        ordenadas
          .map(crearTarjetaColecta)
          .join("");

    }


    function crearTarjetaColecta(c) {

      const cantidad =
        Number(
          c.cantidad_paquetes ??
          c.cantidad ??
          c.paquetes_declarados ??
          0
        );


      const registrados =
        Number(
          c.paquetes_reales ??
          c.paquetes_registrados ??
          c.total_paquetes ??
          0
        );


      const cliente =
        c.cliente_nombre ||
        c.cliente ||
        obtenerNombreCliente(
          clientes.find(
            x =>
              String(x.id) ===
              String(c.cliente_id)
          )
        );


      const chofer =
        c.chofer_nombre ||
        c.chofer ||
        obtenerNombreChofer(
          choferes.find(
            x =>
              String(x.id) ===
              String(c.chofer_id)
          )
        );


      return `

        <div class="colecta-card">

          <div class="colecta-header">

            <div>

              <div class="colecta-title">
                📦 Colecta #${escapar(c.id)}
              </div>

              <div class="colecta-meta">

                <span>
                  <i class="fas fa-building"></i>
                  ${escapar(cliente)}
                </span>

                <span>
                  <i class="fas fa-calendar"></i>
                  ${escapar(obtenerFechaCampo(c))}
                </span>

              </div>

            </div>


            <span class="badge badge-recibida">

              ${escapar(
                c.estado || "Recibida"
              )}

            </span>

          </div>


          <div class="colecta-body">

            <div class="colecta-stats">

              <div class="mini-stat">

                <small>
                  Declarados
                </small>

                <strong>
                  ${cantidad}
                </strong>

              </div>


              <div class="mini-stat">

                <small>
                  Registrados
                </small>

                <strong>
                  ${registrados}
                </strong>

              </div>


              <div class="mini-stat">

                <small>
                  Chofer
                </small>

                <strong>
                  ${escapar(chofer)}
                </strong>

              </div>

            </div>


            <div class="colecta-actions">

              <button
                type="button"
                class="btn btn-teal"
                onclick="verColecta(${Number(c.id) || 0})"
              >

                <i class="fas fa-box-open"></i>

                Ver paquetes

              </button>

            </div>

          </div>

        </div>

      `;

    }


    /* =========================================================
       VER COLECTA
    ========================================================= */

    function verColecta(id) {

      const boton =
        document.querySelector(
          '.nav button[onclick*="paquetes"]'
        );


      mostrarSeccion(
        "paquetes",
        boton
      );


      const paqueteColecta =
        paquetes.filter(p => {

          const paqueteId =
            p.colecta_id ??
            p.colectaId ??
            p.colecta;


          return (
            String(paqueteId) ===
            String(id)
          );

        });


      const div =
        document.getElementById(
          "listaPaquetes"
        );


      if (!div) {
        return;
      }


      if (!paqueteColecta.length) {

        div.innerHTML = `

          <div class="card empty">

            <i class="fas fa-box-open"></i>

            <p>
              Esta colecta no tiene paquetes registrados.
            </p>

          </div>

        `;

        return;

      }


      div.innerHTML =
        paqueteColecta
          .map(crearTarjetaPaquete)
          .join("");

    }


    /* =========================================================
       PAQUETES
    ========================================================= */

    function listarPaquetes() {

      const div =
        document.getElementById(
          "listaPaquetes"
        );


      if (!div) {
        return;
      }


      const texto =
        String(
          document.getElementById(
            "buscarPaquete"
          )?.value || ""
        )
        .toLowerCase()
        .trim();


      const tipo =
        document.getElementById(
          "filtroTipo"
        )?.value || "";


      const estado =
        document.getElementById(
          "filtroEstado"
        )?.value || "";


      const lista =
        paquetes.filter(p => {

          const contenido = [

            p.codigo,
            p.codigo_interno,
            p.codigo_externo,
            p.tracking_number,
            p.destinatario,
            p.dni,
            p.telefono,
            p.direccion,
            p.barrio,
            p.localidad,
            p.zona,
            p.cliente_nombre,
            p.remitente,
            p.referencia

          ]
          .filter(
            valor =>
              valor !== null &&
              valor !== undefined
          )
          .join(" ")
          .toLowerCase();


          const coincideTexto =
            !texto ||
            contenido.includes(texto);


          const coincideTipo =
            !tipo ||
            String(p.tipo || "").toUpperCase() ===
            String(tipo).toUpperCase();


          const coincideEstado =
            !estado ||
            String(p.estado || "") ===
            String(estado);


          return (
            coincideTexto &&
            coincideTipo &&
            coincideEstado
          );

        });


      if (!lista.length) {

        div.innerHTML = `

          <div class="card empty">

            <i class="fas fa-box-open"></i>

            <p>
              No se encontraron paquetes.
            </p>

          </div>

        `;

        return;

      }


      div.innerHTML =
        lista
          .slice()
          .reverse()
          .map(crearTarjetaPaquete)
          .join("");

    }


    /* =========================================================
       TARJETA PAQUETE
    ========================================================= */

    function crearTarjetaPaquete(p) {

      const tipo =
        String(
          p.tipo || "REVISAR"
        ).toUpperCase();


      let badge = "";


      if (tipo === "FLEX") {

        badge = `
          <span class="badge badge-flex">
            🟢 FLEX
          </span>
        `;

      }
      else if (tipo === "PARTICULAR") {

        badge = `
          <span class="badge badge-particular">
            🔴 PARTICULAR
          </span>
        `;

      }
      else {

        badge = `
          <span class="badge badge-review">
            🟠 REVISAR
          </span>
        `;

      }


      const foto =
        p.foto ||
        p.fotografia ||
        p.imagen ||
        "";


      const codigo =
        p.codigo_interno ||
        p.codigo ||
        p.tracking_number ||
        "Sin código";


      const chofer =
        p.chofer_nombre ||
        p.chofer ||
        obtenerNombreChofer(
          choferes.find(
            c =>
              String(c.id) ===
              String(p.chofer_id)
          )
        );


      return `

        <div class="package-card">

          ${
            foto
              ? `

                <img
                  src="${escapar(foto)}"
                  class="package-photo"
                  alt="Fotografía del paquete"
                  loading="lazy"
                  onclick="abrirFoto('${escaparJS(foto)}')"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                >

                <div
                  class="no-photo"
                  style="display:none"
                >

                  <i class="fas fa-image"></i>
                  No se pudo cargar la fotografía

                </div>

              `
              : `

                <div class="no-photo">

                  <i class="fas fa-image"></i>

                  Sin fotografía

                </div>

              `
          }


          <div class="package-body">

            <div class="package-code">

              📦

              ${escapar(codigo)}

            </div>


            ${badge}


            <div class="package-data">

              <div>

                <strong>
                  Destinatario:
                </strong>

                ${escapar(
                  p.destinatario ||
                  "No cargado"
                )}

              </div>


              <div>

                <strong>
                  Dirección:
                </strong>

                ${escapar(
                  p.direccion ||
                  "No cargada"
                )}

              </div>


              <div>

                <strong>
                  Barrio:
                </strong>

                ${escapar(
                  p.barrio ||
                  "No cargado"
                )}

              </div>


              <div>

                <strong>
                  Localidad:
                </strong>

                ${escapar(
                  p.localidad ||
                  "No cargada"
                )}

              </div>


              <div>

                <strong>
                  Zona:
                </strong>

                ${escapar(
                  p.zona ||
                  "No cargada"
                )}

              </div>


              <div>

                <strong>
                  Teléfono:
                </strong>

                ${escapar(
                  p.telefono ||
                  "No cargado"
                )}

              </div>


              <div>

                <strong>
                  Chofer:
                </strong>

                ${escapar(chofer)}

              </div>


              <div>

                <strong>
                  Estado:
                </strong>

                ${escapar(
                  p.estado ||
                  "Pendiente"
                )}

              </div>

            </div>


            <div class="package-actions">

              <button
                type="button"
                class="btn btn-primary"
                onclick="editarPaquete(${Number(p.id) || 0})"
              >

                <i class="fas fa-pen"></i>

                Editar

              </button>


              ${
                tipo !== "FLEX"
                  ? `

                    <button
                      type="button"
                      class="btn btn-green"
                      onclick="cambiarTipo(${Number(p.id) || 0}, 'FLEX')"
                    >

                      <i class="fas fa-check"></i>

                      FLEX

                    </button>

                  `
                  : ""
              }


              ${
                tipo !== "PARTICULAR"
                  ? `

                    <button
                      type="button"
                      class="btn btn-red"
                      onclick="cambiarTipo(${Number(p.id) || 0}, 'PARTICULAR')"
                    >

                      PARTICULAR

                    </button>

                  `
                  : ""
              }


              ${
                tipo !== "REVISAR"
                  ? `

                    <button
                      type="button"
                      class="btn btn-orange"
                      onclick="cambiarTipo(${Number(p.id) || 0}, 'REVISAR')"
                    >

                      REVISAR

                    </button>

                  `
                  : ""
              }

            </div>

          </div>

        </div>

      `;

    }


    /* =========================================================
       EDITAR PAQUETE
    ========================================================= */

    function editarPaquete(id) {

      const paquete =
        paquetes.find(
          p =>
            String(p.id) ===
            String(id)
        );


      if (!paquete) {

        alert(
          "No se encontró el paquete."
        );

        return;

      }


      document.getElementById(
        "editId"
      ).value =
        paquete.id;


      document.getElementById(
        "editTipo"
      ).value =
        paquete.tipo || "REVISAR";


      document.getElementById(
        "editCodigo"
      ).value =
        paquete.codigo_interno ||
        paquete.codigo ||
        paquete.tracking_number ||
        "";


      document.getElementById(
        "editDestinatario"
      ).value =
        paquete.destinatario || "";


      document.getElementById(
        "editDni"
      ).value =
        paquete.dni || "";


      document.getElementById(
        "editTelefono"
      ).value =
        paquete.telefono || "";


      document.getElementById(
        "editDireccion"
      ).value =
        paquete.direccion || "";


      document.getElementById(
        "editBarrio"
      ).value =
        paquete.barrio || "";


      document.getElementById(
        "editLocalidad"
      ).value =
        paquete.localidad || "";


      document.getElementById(
        "editZona"
      ).value =
        paquete.zona || "";


      document.getElementById(
        "editReferencia"
      ).value =
        paquete.referencia || "";


      document.getElementById(
        "editEstado"
      ).value =
        paquete.estado || "Pendiente";


      cargarChoferesSelect(
        "editChofer",
        paquete.chofer_id || ""
      );


      fotoActual =
        paquete.foto ||
        paquete.fotografia ||
        paquete.imagen ||
        "";


      const fotoDiv =
        document.getElementById(
          "fotoEditor"
        );


      if (fotoActual) {

        fotoDiv.innerHTML = `

          <img
            src="${escapar(fotoActual)}"
            class="editor-photo"
            alt="Fotografía del paquete"
            onclick="abrirFotoActual()"
          >

        `;

      }
      else {

        fotoDiv.innerHTML = `

          <div class="no-photo">

            <i class="fas fa-image"></i>

            Sin fotografía

          </div>

        `;

      }


      document
        .getElementById(
          "modalPaquete"
        )
        .classList.add("show");

    }


    /* =========================================================
       GUARDAR PAQUETE
    ========================================================= */

    async function guardarPaquete() {

      const id =
        document.getElementById(
          "editId"
        ).value;


      if (!id) {

        alert(
          "No se encontró el ID del paquete."
        );

        return;

      }


      const datos = {

        tipo:
          document.getElementById(
            "editTipo"
          ).value,

        codigo:
          document.getElementById(
            "editCodigo"
          ).value.trim(),

        destinatario:
          document.getElementById(
            "editDestinatario"
          ).value.trim(),

        dni:
          document.getElementById(
            "editDni"
          ).value.trim(),

        telefono:
          document.getElementById(
            "editTelefono"
          ).value.trim(),

        direccion:
          document.getElementById(
            "editDireccion"
          ).value.trim(),

        barrio:
          document.getElementById(
            "editBarrio"
          ).value.trim(),

        localidad:
          document.getElementById(
            "editLocalidad"
          ).value.trim(),

        zona:
          document.getElementById(
            "editZona"
          ).value.trim(),

        referencia:
          document.getElementById(
            "editReferencia"
          ).value.trim(),

        chofer_id:
          document.getElementById(
            "editChofer"
          ).value || null,

        estado:
          document.getElementById(
            "editEstado"
          ).value

      };


      try {

        await api(
          `/panel/logistica/deposito/api/paquetes/${encodeURIComponent(id)}`,
          {
            method: "PUT",
            body: JSON.stringify(datos)
          }
        );


        cerrarModal(
          "modalPaquete"
        );


        await cargarTodo();


        alert(
          "✅ Paquete actualizado correctamente."
        );

      }
      catch (error) {

        console.error(error);

        alert(
          "❌ No se pudo guardar:\n\n" +
          error.message
        );

      }

    }


    /* =========================================================
       CAMBIAR TIPO
    ========================================================= */

    async function cambiarTipo(id, tipo) {

      if (!id) {

        alert(
          "ID de paquete inválido."
        );

        return;

      }


      if (
        !confirm(
          `¿Marcar este paquete como ${tipo}?`
        )
      ) {
        return;
      }


      try {

        await api(
          `/panel/logistica/deposito/api/paquetes/${encodeURIComponent(id)}/tipo`,
          {
            method: "PUT",
            body: JSON.stringify({
              tipo
            })
          }
        );


        await cargarTodo();

      }
      catch (error) {

        console.error(error);

        alert(
          "❌ Error:\n\n" +
          error.message
        );

      }

    }


    /* =========================================================
       FOTOS
    ========================================================= */

    function abrirFoto(url) {

      if (!url) {
        return;
      }


      const imagen =
        document.getElementById(
          "fotoGrande"
        );


      const modal =
        document.getElementById(
          "modalFoto"
        );


      if (!imagen || !modal) {
        return;
      }


      imagen.src = url;

      modal.classList.add("show");

    }


    function abrirFotoActual() {

      if (fotoActual) {

        abrirFoto(
          fotoActual
        );

      }

    }


    function cerrarModal(id) {

      const modal =
        document.getElementById(id);


      if (!modal) {
        return;
      }


      modal.classList.remove(
        "show"
      );


      if (id === "modalFoto") {

        const imagen =
          document.getElementById(
            "fotoGrande"
          );


        if (imagen) {
          imagen.src = "";
        }

      }

    }


    /* =========================================================
       CLIENTES - SELECT
    ========================================================= */

    function cargarClientesSelect() {

      const select =
        document.getElementById(
          "nuevoCliente"
        );


      if (!select) {
        return;
      }


      const valorActual =
        select.value;


      select.innerHTML = `

        <option value="">
          Seleccionar cliente
        </option>

      `;


      clientes.forEach(c => {

        const option =
          document.createElement(
            "option"
          );


        option.value =
          c.id;


        option.textContent =
          obtenerNombreCliente(c);


        select.appendChild(
          option
        );

      });


      if (
        valorActual &&
        clientes.some(
          c =>
            String(c.id) ===
            String(valorActual)
        )
      ) {

        select.value =
          valorActual;

      }

    }


