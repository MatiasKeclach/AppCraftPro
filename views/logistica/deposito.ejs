
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Control de Depósito - AppCraft Pro</title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --dark: #111827;
      --dark2: #1e293b;
      --bg: #f1f5f9;
      --card: #ffffff;
      --border: #e2e8f0;
      --text: #1e293b;
      --muted: #64748b;
      --green: #16a34a;
      --red: #dc2626;
      --orange: #ea580c;
      --yellow: #ca8a04;
      --teal: #0f766e;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* =========================
       HEADER
    ========================= */

    .header {
      background: linear-gradient(135deg, #111827, #1e293b);
      color: white;
      padding: 22px 28px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, .15);
    }

    .header-inner {
      max-width: 1600px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .header h1 {
      font-size: 25px;
      margin-bottom: 5px;
    }

    .header p {
      opacity: .75;
      font-size: 13px;
    }

    .header-user {
      background: rgba(255, 255, 255, .08);
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 13px;
    }

    /* =========================
       NAV
    ========================= */

    .nav {
      background: white;
      border-bottom: 1px solid var(--border);
      padding: 10px 20px;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 8px rgba(0, 0, 0, .05);
    }

    .nav-inner {
      max-width: 1600px;
      margin: auto;
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
    }

    .nav button {
      border: 0;
      background: transparent;
      color: #475569;
      padding: 11px 15px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      font-size: 13px;
    }

    .nav button:hover {
      background: #f1f5f9;
    }

    .nav button.active {
      background: var(--primary);
      color: white;
    }

    /* =========================
       MAIN
    ========================= */

    .container {
      max-width: 1600px;
      margin: auto;
      padding: 24px;
    }

    .section {
      display: none;
    }

    .section.active {
      display: block;
    }

    /* =========================
       CARDS
    ========================= */

    .card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: 0 4px 15px rgba(15, 23, 42, .05);
    }

    .card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 18px;
    }

    .card-title h2 {
      font-size: 19px;
    }

    .card-title p {
      color: var(--muted);
      font-size: 13px;
      margin-top: 4px;
    }

    /* =========================
       BUTTONS
    ========================= */

    .btn {
      border: 0;
      border-radius: 8px;
      padding: 10px 15px;
      cursor: pointer;
      font-weight: bold;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: .15s ease;
    }

    .btn:hover {
      opacity: .9;
      transform: translateY(-1px);
    }

    .btn:disabled {
      opacity: .55;
      cursor: not-allowed;
      transform: none;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-green {
      background: var(--green);
      color: white;
    }

    .btn-red {
      background: var(--red);
      color: white;
    }

    .btn-orange {
      background: var(--orange);
      color: white;
    }

    .btn-gray {
      background: #64748b;
      color: white;
    }

    .btn-teal {
      background: var(--teal);
      color: white;
    }

    .btn-light {
      background: #e2e8f0;
      color: #334155;
    }

    /* =========================
       DASHBOARD
    ========================= */

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 15px;
    }

    .stat {
      background: white;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .04);
    }

    .stat-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #eff6ff;
      color: var(--primary);
      margin-bottom: 14px;
    }

    .stat-number {
      font-size: 30px;
      font-weight: bold;
    }

    .stat-label {
      color: var(--muted);
      font-size: 13px;
      margin-top: 5px;
    }

    .stat.flex-stat .stat-icon {
      background: #dcfce7;
      color: var(--green);
    }

    .stat.particular-stat .stat-icon {
      background: #fee2e2;
      color: var(--red);
    }

    .stat.review-stat .stat-icon {
      background: #ffedd5;
      color: var(--orange);
    }

    /* =========================
       FILTERS
    ========================= */

    .filters {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field label {
      font-size: 12px;
      font-weight: bold;
      color: #475569;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      background: white;
      color: var(--text);
      outline: none;
      font-family: inherit;
    }

    textarea {
      resize: vertical;
      min-height: 80px;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
    }

    /* =========================
       TABLES
    ========================= */

    .table-wrapper {
      overflow-x: auto;
      width: 100%;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 850px;
    }

    thead th {
      background: #111827;
      color: white;
      padding: 12px;
      text-align: left;
      font-size: 12px;
      white-space: nowrap;
    }

    tbody td {
      padding: 11px 12px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }

    tbody tr:hover {
      background: #f8fafc;
    }

    /* =========================
       BADGES
    ========================= */

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 9px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: bold;
    }

    .badge-flex {
      background: #dcfce7;
      color: #166534;
    }

    .badge-particular {
      background: #fee2e2;
      color: #991b1b;
    }

    .badge-review {
      background: #ffedd5;
      color: #9a3412;
    }

    .badge-pendiente {
      background: #fef3c7;
      color: #92400e;
    }

    .badge-entregado {
      background: #dcfce7;
      color: #166534;
    }

    .badge-recibida {
      background: #dbeafe;
      color: #1e40af;
    }

    /* =========================
       COLECTAS
    ========================= */

    .colectas-grid {
      display: grid;
      gap: 15px;
    }

    .colecta-card {
      border: 1px solid var(--border);
      border-radius: 13px;
      overflow: hidden;
      background: white;
    }

    .colecta-header {
      padding: 17px;
      background: #f8fafc;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 15px;
      flex-wrap: wrap;
    }

    .colecta-title {
      font-weight: bold;
      font-size: 16px;
    }

    .colecta-meta {
      color: var(--muted);
      font-size: 12px;
      margin-top: 6px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .colecta-body {
      padding: 17px;
    }

    .colecta-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 10px;
    }

    .mini-stat {
      background: #f8fafc;
      padding: 12px;
      border-radius: 9px;
    }

    .mini-stat small {
      display: block;
      color: var(--muted);
      margin-bottom: 5px;
    }

    .mini-stat strong {
      font-size: 18px;
    }

    .colecta-actions {
      display: flex;
      gap: 8px;
      margin-top: 15px;
      flex-wrap: wrap;
    }

    /* =========================
       PACKAGES
    ========================= */

    .packages-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 16px;
    }

    .package-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 13px;
      overflow: hidden;
    }

    .package-photo {
      width: 100%;
      height: 210px;
      object-fit: cover;
      background: #e2e8f0;
      cursor: pointer;
      display: block;
    }

    .no-photo {
      height: 210px;
      background: #e2e8f0;
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 8px;
    }

    .no-photo i {
      font-size: 38px;
    }

    .package-body {
      padding: 16px;
    }

    .package-code {
      font-weight: bold;
      font-size: 16px;
      margin-bottom: 9px;
      word-break: break-word;
    }

    .package-data {
      display: grid;
      gap: 6px;
      margin-top: 12px;
    }

    .package-data div {
      font-size: 12px;
      color: #64748b;
      word-break: break-word;
    }

    .package-data strong {
      color: #1e293b;
    }

    .package-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: 15px;
    }

    /* =========================
       MODAL
    ========================= */

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, .72);
      z-index: 1000;
      padding: 20px;
      overflow: auto;
    }

    .modal.show {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-box {
      width: min(1000px, 100%);
      max-height: 95vh;
      overflow: auto;
      background: white;
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, .3);
    }

    .modal-header {
      padding: 17px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      position: sticky;
      top: 0;
      background: white;
      z-index: 2;
    }

    .modal-header h3 {
      font-size: 18px;
    }

    .modal-close {
      border: 0;
      background: #f1f5f9;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 18px;
    }

    .modal-body {
      padding: 20px;
    }

    /* =========================
       EDITOR
    ========================= */

    .package-editor {
      display: grid;
      grid-template-columns: minmax(280px, 1fr) minmax(300px, 1fr);
      gap: 20px;
    }

    .editor-photo {
      width: 100%;
      max-height: 550px;
      object-fit: contain;
      background: #f1f5f9;
      border-radius: 12px;
      border: 1px solid var(--border);
      cursor: pointer;
    }

    .editor-fields {
      display: grid;
      gap: 10px;
    }

    .editor-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 12px;
    }

    /* =========================
       PROGRESS
    ========================= */

    .progress-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px;
      margin-top: 15px;
    }

    .progress-track {
      height: 11px;
      background: #e2e8f0;
      border-radius: 20px;
      overflow: hidden;
      margin-top: 9px;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: var(--primary);
      transition: width .2s ease;
    }

    /* =========================
       EMPTY / LOADING
    ========================= */

    .empty {
      padding: 40px 20px;
      text-align: center;
      color: var(--muted);
    }

    .empty i {
      font-size: 40px;
      margin-bottom: 12px;
    }

    .loading {
      padding: 35px;
      text-align: center;
      color: var(--muted);
    }

    .loading i {
      font-size: 28px;
      margin-bottom: 10px;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 800px) {
      .header-inner {
        align-items: flex-start;
        flex-direction: column;
      }

      .container {
        padding: 15px;
      }

      .package-editor {
        grid-template-columns: 1fr;
      }

      .nav {
        position: static;
      }

      .nav-inner {
        overflow-x: auto;
        flex-wrap: nowrap;
      }

      .nav button {
        white-space: nowrap;
      }
    }

    @media (max-width: 500px) {
      .header {
        padding: 18px;
      }

      .header h1 {
        font-size: 21px;
      }

      .container {
        padding: 10px;
      }

      .card {
        padding: 15px;
        border-radius: 12px;
      }

      .package-actions .btn {
        flex: 1;
      }
    }
  </style>
</head>

<body>

  <!-- =========================
       HEADER
  ========================= -->

  <header class="header">
    <div class="header-inner">

      <div>
        <h1>📦 Control de Depósito</h1>

        <p>
          Gestión integral de colectas, paquetes, clientes y choferes
        </p>
      </div>

      <div class="header-user">
        <i class="fas fa-user"></i>
        <%= username || 'Usuario' %>
      </div>

    </div>
  </header>


  <!-- =========================
       NAV
  ========================= -->

  <nav class="nav">
    <div class="nav-inner">

      <button
        type="button"
        class="active"
        onclick="mostrarSeccion('dashboard', this)"
      >
        <i class="fas fa-chart-line"></i>
        Dashboard
      </button>

      <button
        type="button"
        onclick="mostrarSeccion('colectas', this)"
      >
        <i class="fas fa-truck-loading"></i>
        Colectas
      </button>

      <button
        type="button"
        onclick="mostrarSeccion('paquetes', this)"
      >
        <i class="fas fa-box"></i>
        Paquetes
      </button>

      <button
        type="button"
        onclick="mostrarSeccion('clientes', this)"
      >
        <i class="fas fa-building"></i>
        Clientes
      </button>

      <button
        type="button"
        onclick="mostrarSeccion('choferes', this)"
      >
        <i class="fas fa-motorcycle"></i>
        Choferes
      </button>

      <button
        type="button"
        onclick="mostrarSeccion('consultas', this)"
      >
        <i class="fas fa-search"></i>
        Consultas
      </button>

    </div>
  </nav>


  <!-- =========================
       MAIN
  ========================= -->

  <main class="container">

    <!-- =========================
         DASHBOARD
    ========================= -->

    <section id="dashboard" class="section active">

      <div class="card">

        <div class="card-title">

          <div>
            <h2>Resumen operativo</h2>
            <p>Estado actual del depósito</p>
          </div>

          <button
            type="button"
            class="btn btn-primary"
            onclick="cargarTodo()"
          >
            <i class="fas fa-sync"></i>
            Actualizar
          </button>

        </div>


        <div class="stats">

          <div class="stat">
            <div class="stat-icon">
              <i class="fas fa-box"></i>
            </div>

            <div class="stat-number" id="statTotal">0</div>

            <div class="stat-label">
              Total paquetes
            </div>
          </div>


          <div class="stat flex-stat">
            <div class="stat-icon">
              <i class="fas fa-qrcode"></i>
            </div>

            <div class="stat-number" id="statFlex">0</div>

            <div class="stat-label">
              Flex
            </div>
          </div>


          <div class="stat particular-stat">
            <div class="stat-icon">
              <i class="fas fa-box-open"></i>
            </div>

            <div class="stat-number" id="statParticular">0</div>

            <div class="stat-label">
              Particulares
            </div>
          </div>


          <div class="stat review-stat">
            <div class="stat-icon">
              <i class="fas fa-triangle-exclamation"></i>
            </div>

            <div class="stat-number" id="statRevision">0</div>

            <div class="stat-label">
              Para revisar
            </div>
          </div>


          <div class="stat">
            <div class="stat-icon">
              <i class="fas fa-truck"></i>
            </div>

            <div class="stat-number" id="statColectas">0</div>

            <div class="stat-label">
              Colectas
            </div>
          </div>


          <div class="stat">
            <div class="stat-icon">
              <i class="fas fa-motorcycle"></i>
            </div>

            <div class="stat-number" id="statPendientes">0</div>

            <div class="stat-label">
              Pendientes
            </div>
          </div>

        </div>

      </div>


      <div class="card">

        <div class="card-title">

          <div>
            <h2>Últimas colectas</h2>
            <p>Actividad reciente del depósito</p>
          </div>

        </div>

        <div id="dashboardColectas">
          <div class="loading">
            <i class="fas fa-spinner fa-spin"></i>
            <p>Cargando información...</p>
          </div>
        </div>

      </div>

    </section>


    <!-- =========================
         COLECTAS
    ========================= -->

    <section id="colectas" class="section">

      <div class="card">

        <div class="card-title">

          <div>
            <h2>📥 Nueva colecta</h2>
            <p>Cargar y procesar paquetes recibidos</p>
          </div>

        </div>


        <div class="filters">

          <div class="field">
            <label for="nuevaFecha">
              Fecha
            </label>

            <input
              type="date"
              id="nuevaFecha"
            >
          </div>


          <div class="field">
            <label for="nuevoCliente">
              Cliente
            </label>

            <select id="nuevoCliente">
              <option value="">
                Seleccionar cliente
              </option>
            </select>
          </div>


          <div class="field">
            <label for="nuevasFotos">
              Fotografías
            </label>

            <input
              type="file"
              id="nuevasFotos"
              multiple
              accept="image/*"
            >
          </div>

        </div>


        <div style="margin-top:15px">

          <p style="font-size:12px;color:#64748b">

            <i class="fas fa-info-circle"></i>

            El sistema intentará identificar automáticamente los paquetes.
            Los casos que no puedan confirmarse quedarán como
            <strong>REVISAR</strong> para clasificación manual.

          </p>

        </div>


        <div style="margin-top:15px">

          <button
            type="button"
            class="btn btn-green"
            id="btnProcesar"
            onclick="procesarColecta()"
          >

            <i class="fas fa-camera"></i>

            Procesar colecta

          </button>

        </div>


        <div
          id="progressBox"
          class="progress-box"
          style="display:none"
        >

          <div id="progressText">
            Preparando...
          </div>

          <div class="progress-track">

            <div
              id="progressBar"
              class="progress-bar"
            ></div>

          </div>

        </div>

      </div>


      <div class="card">

        <div class="card-title">

          <div>
            <h2>Colectas registradas</h2>
            <p>Buscar y administrar colectas</p>
          </div>

        </div>


        <div class="filters">

          <div class="field">

            <label for="buscarColecta">
              Buscar
            </label>

            <input
              id="buscarColecta"
              placeholder="Cliente, ID..."
              oninput="listarColectas()"
            >

          </div>


          <div class="field">

            <label for="fechaFiltro">
              Fecha
            </label>

            <input
              type="date"
              id="fechaFiltro"
              onchange="listarColectas()"
            >

          </div>

        </div>

      </div>


      <div
        id="listaColectas"
        class="colectas-grid"
      >

        <div class="loading">
          <i class="fas fa-spinner fa-spin"></i>
          <p>Cargando colectas...</p>
        </div>

      </div>

    </section>


    <!-- =========================
         PAQUETES
    ========================= -->

    <section id="paquetes" class="section">

      <div class="card">

        <div class="card-title">

          <div>
            <h2>📦 Paquetes</h2>
            <p>Todos los paquetes registrados en el depósito</p>
          </div>

          <button
            type="button"
            class="btn btn-primary"
            onclick="listarPaquetes()"
          >

            <i class="fas fa-sync"></i>
            Actualizar

          </button>

        </div>


        <div class="filters">

          <div class="field">

            <label for="buscarPaquete">
              Buscar
            </label>

            <input
              id="buscarPaquete"
              placeholder="Código, dirección, DNI, teléfono, destinatario..."
              oninput="listarPaquetes()"
            >

          </div>


          <div class="field">

            <label for="filtroTipo">
              Tipo
            </label>

            <select
