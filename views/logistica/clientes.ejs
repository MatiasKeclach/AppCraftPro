<!DOCTYPE html>

<html lang="es">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Clientes - Logística</title>

<link rel="stylesheet" href="/css/panel.css">

<style>

:root{
    --primary:#2563eb;
    --success:#16a34a;
    --danger:#dc2626;
    --dark:#0f172a;
    --bg:#f1f5f9;
    --card:#ffffff;
    --border:#e2e8f0;
    --text:#334155;
    --shadow:0 10px 25px rgba(15,23,42,.08);
}

*{
    box-sizing:border-box;
}

body{
    margin:0;
    background:var(--bg);
    font-family:Inter,Arial,Helvetica,sans-serif;
    color:var(--text);
}

.header{
    background:linear-gradient(135deg,#0f172a,#2563eb);
    color:white;
    padding:25px;
    box-shadow:var(--shadow);
}

.header h2{
    margin:0;
    font-size:25px;
}

.header p{
    margin:8px 0 0;
    opacity:.8;
}

.container{
    width:100%;
    max-width:1200px;
    margin:auto;
    padding:20px;
}

.box{
    background:white;
    border-radius:18px;
    padding:25px;
    margin-bottom:25px;
    box-shadow:var(--shadow);
    border:1px solid var(--border);
}

.box h3{
    margin-top:0;
    color:var(--dark);
}

.form-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:14px;
}

input{
    width:100%;
    padding:14px;
    border-radius:12px;
    border:1px solid #cbd5e1;
    font-size:15px;
}

input:focus{
    outline:none;
    border-color:var(--primary);
    box-shadow:0 0 0 3px rgba(37,99,235,.15);
}

.btn-primary{
    background:var(--primary);
    color:white;
    border:none;
    padding:14px;
    border-radius:12px;
    font-size:16px;
    font-weight:bold;
    cursor:pointer;
    transition:.2s;
}

.btn-primary:hover{
    opacity:.9;
}

.btn-primary:disabled{
    opacity:.6;
    cursor:not-allowed;
}

.table-container{
    width:100%;
    overflow-x:auto;
}

table{
    width:100%;
    min-width:950px;
    border-collapse:collapse;
}

thead{
    background:#f8fafc;
}

th{
    color:#475569;
    text-align:left;
}

th,
td{
    padding:14px;
    border-bottom:1px solid var(--border);
}

tbody tr:hover{
    background:#f8fafc;
}

.btn-edit,
.btn-delete{
    color:white;
    text-decoration:none;
    padding:8px 12px;
    border-radius:8px;
    font-size:14px;
    display:inline-block;
    margin:2px;
}

.btn-edit{
    background:var(--success);
}

.btn-delete{
    background:var(--danger);
}

.mensaje{
    display:none;
    padding:14px 16px;
    border-radius:12px;
    margin-bottom:20px;
    font-weight:600;
}

.mensaje.success{
    display:block;
    background:#dcfce7;
    color:#166534;
    border:1px solid #86efac;
}

.mensaje.error{
    display:block;
    background:#fee2e2;
    color:#991b1b;
    border:1px solid #fca5a5;
}

.estado-vacio{
    text-align:center;
    padding:30px;
    color:#64748b;
}

@media(min-width:768px){

    .form-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .btn-primary{
        grid-column:span 2;
    }

}

@media(min-width:1100px){

    .container{
        padding:35px;
    }

}

</style>

</head>

<body>

<div class="header">

```
<h2>
    👥 Clientes Logística
</h2>

<p>
    Usuario: <%= username %>
</p>
```

</div>

<div class="container">

```
<!-- MENSAJES -->

<div id="mensaje" class="mensaje"></div>


<!-- NUEVO CLIENTE -->

<div class="box">

    <h3>
        ➕ Nuevo cliente
    </h3>

    <form
        id="formCliente"
        method="POST"
        action="/panel/logistica/clientes"
    >

        <div class="form-grid">

            <input
                name="nombre"
                placeholder="Nombre del cliente"
                required
                autocomplete="off"
            >

            <input
                name="empresa"
                placeholder="Empresa"
                autocomplete="organization"
            >

            <input
                name="telefono"
                placeholder="Teléfono"
                autocomplete="tel"
            >

            <input
                name="email"
                type="email"
                placeholder="Email"
                autocomplete="email"
            >

            <input
                name="direccion"
                placeholder="Dirección"
                autocomplete="street-address"
            >

            <button
                id="btnGuardar"
                class="btn-primary"
                type="submit"
            >
                💾 Guardar cliente
            </button>

        </div>

    </form>

</div>


<!-- CLIENTES -->

<div class="box">

    <h3>
        📋 Clientes registrados
    </h3>

    <div class="table-container">

        <table>

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Empresa</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Dirección</th>
                    <th>Acciones</th>

                </tr>

            </thead>

            <tbody>

                <% if (clientes && clientes.length > 0) { %>

                    <% clientes.forEach(cliente => { %>

                        <tr>

                            <td>
                                <%= cliente.id %>
                            </td>

                            <td>
                                <%= cliente.nombre %>
                            </td>

                            <td>
                                <%= cliente.empresa || "-" %>
                            </td>

                            <td>
                                <%= cliente.telefono || "-" %>
                            </td>

                            <td>
                                <%= cliente.email || "-" %>
                            </td>

                            <td>
                                <%= cliente.direccion || "-" %>
                            </td>

                            <td>

                                <a
                                    class="btn-edit"
                                    href="/panel/logistica/clientes/editar/<%= cliente.id %>"
                                >
                                    ✏️ Editar
                                </a>

                                <a
                                    class="btn-delete"
                                    href="/panel/logistica/clientes/eliminar/<%= cliente.id %>"
                                    onclick="return confirm('¿Seguro que desea eliminar este cliente?')"
                                >
                                    🗑️ Borrar
                                </a>

                            </td>

                        </tr>

                    <% }) %>

                <% } else { %>

                    <tr>

                        <td
                            colspan="7"
                            class="estado-vacio"
                        >
                            📭 No hay clientes registrados todavía.
                        </td>

                    </tr>

                <% } %>

            </tbody>

        </table>

    </div>

</div>
```

</div>

<script>

/*
====================================================
CREAR CLIENTE
====================================================
*/

const formCliente = document.getElementById("formCliente");
const mensaje = document.getElementById("mensaje");
const btnGuardar = document.getElementById("btnGuardar");


function mostrarMensaje(texto, tipo){

    mensaje.textContent = texto;

    mensaje.className = "mensaje " + tipo;

}


formCliente.addEventListener("submit", async function(event){

    event.preventDefault();

    btnGuardar.disabled = true;
    btnGuardar.textContent = "⏳ Guardando...";

    mensaje.className = "mensaje";
    mensaje.textContent = "";

    try {

        const formData = new FormData(formCliente);

        const response = await fetch(
            formCliente.action,
            {
                method:"POST",
                body:formData,
                headers:{
                    "Accept":"application/json"
                }
            }
        );


        /*
        ==============================================
        VERIFICAR RESPUESTA HTTP
        ==============================================
        */

        if(!response.ok){

            const texto = await response.text();

            console.error(
                "Respuesta del servidor:",
                texto
            );

            throw new Error(
                "El servidor respondió con error HTTP " +
                response.status
            );

        }


        /*
        ==============================================
        LEER JSON
        ==============================================
        */

        const data = await response.json();


        if(!data.ok){

            throw new Error(
                data.mensaje ||
                "No se pudo crear el cliente."
            );

        }


        /*
        ==============================================
        ÉXITO
        ==============================================
        */

        mostrarMensaje(
            data.mensaje || "Cliente creado correctamente.",
            "success"
        );


        formCliente.reset();


        /*
        ==============================================
        RECARGAR LISTADO
        ==============================================
        */

        setTimeout(function(){

            window.location.href =
                "/panel/logistica/clientes";

        }, 700);


    } catch(error){

        console.error(
            "❌ Error creando cliente:",
            error
        );


        mostrarMensaje(
            error.message ||
            "Error creando cliente.",
            "error"
        );


    } finally {

        btnGuardar.disabled = false;

        btnGuardar.textContent =
            "💾 Guardar cliente";

    }

});

</script>

</body>

</html>
