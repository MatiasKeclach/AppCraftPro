
<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Colectas - AppCraft Pro</title>

    <link
        rel="stylesheet"
        href="/css/panel.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f4f6f9;
            font-family: Arial, Helvetica, sans-serif;
            color: #1e293b;
        }

        .header {
            background: #1e293b;
            color: white;
            padding: 25px;
            box-shadow: 0 3px 15px rgba(0,0,0,.15);
        }

        .header h1 {
            font-size: 28px;
            margin-bottom: 8px;
        }

        .header p {
            opacity: .85;
        }

        .container {
            max-width: 1400px;
            margin: auto;
            padding: 25px;
        }

        /* ==========================
           CABECERA
        ========================== */

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .top-bar h2 {
            font-size: 22px;
        }

        .btn {
            border: none;
            border-radius: 8px;
            padding: 11px 16px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .btn-primary:hover {
            background: #1d4ed8;
        }

        /* ==========================
           FILTROS
        ========================== */

        .filters {
            background: white;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,.07);
            margin-bottom: 25px;

            display: grid;
            grid-template-columns:
                repeat(auto-fit,minmax(200px,1fr));

            gap: 15px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .field label {
            font-size: 13px;
            font-weight: bold;
            color: #475569;
        }

        .field input,
        .field select {
            width: 100%;
            padding: 11px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            outline: none;
            background: white;
        }

        .field input:focus,
        .field select:focus {
            border-color: #2563eb;
        }

        /* ==========================
           ESTADÍSTICAS
        ========================== */

        .stats {
            display: grid;
            grid-template-columns:
                repeat(auto-fit,minmax(180px,1fr));

            gap: 15px;
            margin-bottom: 25px;
        }

        .stat {
            background: white;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,.06);
        }

        .stat i {
            font-size: 25px;
            color: #2563eb;
            margin-bottom: 10px;
        }

        .stat-number {
            font-size: 28px;
            font-weight: bold;
        }

        .stat-label {
            color: #64748b;
            font-size: 13px;
            margin-top: 4px;
        }

        /* ==========================
           COLECTAS
        ========================== */

        .colectas {
            display: grid;
            gap: 20px;
        }

        .colecta {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,.07);
            overflow: hidden;
        }

        .colecta-header {
            padding: 20px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;

            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;

            flex-wrap: wrap;
        }

        .colecta-info h3 {
            margin-bottom: 7px;
        }

        .colecta-info p {
            color: #64748b;
            font-size: 14px;
        }

        .badge {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-success {
            background: #dcfce7;
            color: #166534;
        }

        .badge-warning {
            background: #fef3c7;
            color: #92400e;
        }

        .colecta-body {
            padding: 20px;
        }

        .colecta-resumen {
            display: grid;

            grid-template-columns:
                repeat(auto-fit,minmax(150px,1fr));

            gap: 12px;
            margin-bottom: 18px;
        }

        .resumen-item {
            background: #f8fafc;
            padding: 13px;
            border-radius: 9px;
        }

        .resumen-item small {
            display: block;
            color: #64748b;
            margin-bottom: 4px;
        }

        .resumen-item strong {
            font-size: 16px;
        }

        .btn-ver {
            background: #0f766e;
            color: white;
        }

        .btn-ver:hover {
            background: #115e59;
        }

        /* ==========================
           PAQUETES
        ========================== */

        .paquetes {
            display: none;
            margin-top: 20px;
            border-top: 1px solid #e2e8f0;
            padding-top: 20px;
        }

        .paquetes.abierto {
            display: block;
        }

        .paquetes-grid {
            display: grid;

            grid-template-columns:
                repeat(auto-fill,minmax(260px,1fr));

            gap: 18px;
        }

        .paquete {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            background: white;
        }

        .foto-paquete {
            width: 100%;
            height: 190px;
            object-fit: cover;
            background: #e2e8f0;
            cursor: pointer;
        }

        .sin-foto {
            height: 190px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e2e8f0;
            color: #64748b;
            flex-direction: column;
            gap: 8px;
        }

        .sin-foto i {
            font-size: 35px;
        }

        .paquete-info {
            padding: 15px;
        }

        .paquete-info h4 {
            margin-bottom: 10px;
        }

        .dato {
            font-size: 13px;
            margin-bottom: 7px;
            color: #475569;
        }

        .dato strong {
            color: #1e293b;
        }

        .sin-paquetes {
            text-align: center;
            padding: 35px;
            color: #64748b;
        }

        /* ==========================
           RESPONSIVE
        ========================== */

        @media(max-width:700px) {

            .container {
                padding: 15px;
            }

            .header {
                padding: 20px;
            }

            .colecta-header {
                align-items: flex-start;
                flex-direction: column;
            }

        }

    </style>

</head>


<body>


<header class="header">

    <h1>
        📦 Gestión de Colectas
    </h1>

    <p>
        Usuario:
        <strong>
            <%= username %>
        </strong>
    </p>

</header>


<main class="container">


    <!-- ==========================
         CABECERA
    =========================== -->

    <div class="top-bar">

        <div>

            <h2>
                Colectas recibidas
            </h2>

        </div>


        <a
            href="/panel/logistica"
            class="btn btn-primary"
        >

            <i class="fas fa-arrow-left"></i>

            Volver a logística

        </a>

    </div>



    <!-- ==========================
         FILTROS
    =========================== -->

    <section class="filters">


        <div class="field">

            <label>
                Buscar
            </label>

            <input
                type="text"
                id="buscar"
                placeholder="Cliente, colecta..."
            >

        </div>


        <div class="field">

            <label>
                Fecha
            </label>

            <input
                type="date"
                id="fecha"
            >

        </div>


        <div class="field">

            <label>
                Cliente
            </label>

            <select id="cliente">

                <option value="">
                    Todos los clientes
                </option>

                <% clientes.forEach(cliente => { %>

                    <option value="<%= cliente.id %>">

                        <%= cliente.nombre %>

                        <% if(cliente.empresa){ %>
                            - <%= cliente.empresa %>
                        <% } %>

                    </option>

                <% }) %>

            </select>

        </div>


    </section>



    <!-- ==========================
         ESTADÍSTICAS
    =========================== -->

    <section class="stats">


        <div class="stat">

            <i class="fas fa-truck-loading"></i>

            <div
                class="stat-number"
                id="totalColectas"
            >
                0
            </div>

            <div class="stat-label">
                Colectas visibles
            </div>

        </div>


        <div class="stat">

            <i class="fas fa-box"></i>

            <div
                class="stat-number"
                id="totalPaquetes"
            >
                0
            </div>

            <div class="stat-label">
                Paquetes
            </div>

        </div>


    </section>



    <!-- ==========================
         LISTADO
    =========================== -->

    <section
        class="colectas"
        id="listaColectas"
    >


        <% if(colectas.length === 0){ %>


            <div class="sin-paquetes">

                <i
                    class="fas fa-box-open"
                    style="font-size:45px;margin-bottom:15px;"
                ></i>

                <h3>
                    No hay colectas registradas
                </h3>

                <p>
                    Cuando registres una colecta,
                    aparecerá aquí.
                </p>

            </div>


        <% } %>



        <% colectas.forEach(colecta => { %>


            <article
                class="colecta"
                data-id="<%= colecta.id %>"
                data-cliente="<%= colecta.cliente_id %>"
                data-fecha="<%= colecta.fecha ? colecta.fecha.substring(0,10) : '' %>"
                data-busqueda="<%= (colecta.cliente_nombre || '').toLowerCase() %>"
            >


                <!-- HEADER -->

                <div class="colecta-header">


                    <div class="colecta-info">

                        <h3>

                            Colecta
                            #<%= colecta.id %>

                        </h3>


                        <p>

                            <i class="fas fa-user"></i>

                            <%= colecta.cliente_nombre || 'Sin cliente' %>

                        </p>


                        <p>

                            <i class="fas fa-calendar"></i>

                            <%= colecta.fecha || 'Sin fecha' %>

                        </p>

                    </div>



                    <div>

                        <span
                            class="badge badge-success"
                        >

                            <%= colecta.estado || 'recibida' %>

                        </span>

                    </div>


                </div>



                <!-- BODY -->

                <div class="colecta-body">


                    <div class="colecta-resumen">


                        <div class="resumen-item">

                            <small>
                                Paquetes declarados
                            </small>

                            <strong>

                                <%= colecta.cantidad_paquetes || 0 %>

                            </strong>

                        </div>


                        <div class="resumen-item">

                            <small>
                                Paquetes registrados
                            </small>

                            <strong>

                                <%= colecta.paquetes_reales || 0 %>

                            </strong>

                        </div>


                        <div class="resumen-item">

                            <small>
                                Chofer
                            </small>

                            <strong>

                                <%= colecta.chofer || 'Sin asignar' %>

                            </strong>

                        </div>


                    </div>



                    <button
                        type="button"
                        class="btn btn-ver"
                        onclick="verColecta(<%= colecta.id %>)"
                    >

                        <i class="fas fa-box-open"></i>

                        Ver paquetes

                    </button>



                    <!-- PAQUETES -->

                    <div
                        class="paquetes"
                        id="paquetes-<%= colecta.id %>"
                    >

                        <div
                            class="paquetes-grid"
                            id="grid-<%= colecta.id %>"
                        >

                            <div class="sin-paquetes">

                                <i class="fas fa-spinner fa-spin"></i>

                                Cargando paquetes...

                            </div>

                        </div>

                    </div>


                </div>


            </article>


        <% }) %>


    </section>


</main>



<script>


// ======================================================
// CARGAR PAQUETES DE UNA COLECTA
// ======================================================

async function verColecta(id) {


    const contenedor =
        document.getElementById(
            `paquetes-${id}`
        );


    const grid =
        document.getElementById(
            `grid-${id}`
        );


    if (
        contenedor.classList.contains("abierto")
    ) {

        contenedor.classList.remove("abierto");

        return;

    }


    contenedor.classList.add("abierto");


    try {


        const respuesta =
            await fetch(
                `/panel/logistica/api/colectas/${id}/paquetes`
            );


        const datos =
            await respuesta.json();


        if (
            !datos.ok
        ) {

            throw new Error(
                datos.mensaje ||
                "Error cargando paquetes"
            );

        }


        if (
            !datos.paquetes ||
            datos.paquetes.length === 0
        ) {

            grid.innerHTML = `

                <div class="sin-paquetes">

                    <i
                        class="fas fa-box-open"
                        style="font-size:35px"
                    ></i>

                    <p>
                        Esta colecta todavía no tiene paquetes.
                    </p>

                </div>

            `;

            return;

        }


        grid.innerHTML =
            datos.paquetes
            .map(paquete => {


                const foto =
                    paquete.foto;


                return `

                    <div class="paquete">


                        ${
                            foto

                            ?

                            `

                            <img
                                src="${foto}"
                                class="foto-paquete"
                                onclick="abrirFoto('${foto}')"
                                alt="Foto del paquete"
                            >

                            `

                            :

                            `

                            <div class="sin-foto">

                                <i class="fas fa-image"></i>

                                <span>
                                    Sin fotografía
                                </span>

                            </div>

                            `
                        }


                        <div class="paquete-info">


                            <h4>

                                📦
                                ${
                                    paquete.codigo_interno ||
                                    paquete.codigo ||
                                    'Sin código'
                                }

                            </h4>


                            <div class="dato">

                                <strong>
                                    Destinatario:
                                </strong>

                                ${
                                    paquete.destinatario ||
                                    'No cargado'
                                }

                            </div>


                            <div class="dato">

                                <strong>
                                    Dirección:
                                </strong>

                                ${
                                    paquete.direccion ||
                                    'No cargada'
                                }

                            </div>


                            <div class="dato">

                                <strong>
                                    Barrio:
                                </strong>

                                ${
                                    paquete.barrio ||
                                    'No cargado'
                                }

                            </div>


                            <div class="dato">

                                <strong>
                                    Zona:
                                </strong>

                                ${
                                    paquete.zona ||
                                    'No cargada'
                                }

                            </div>


                            <div class="dato">

                                <strong>
                                    Cliente:
                                </strong>

                                ${
                                    paquete.cliente_nombre ||
                                    'Sin cliente'
                                }

                            </div>


                        </div>


                    </div>

                `;

            })
            .join("");


    } catch(error) {


        console.error(error);


        grid.innerHTML = `

            <div class="sin-paquetes">

                ❌

                Error cargando los paquetes.

            </div>

        `;

    }

}



// ======================================================
// ABRIR FOTO
// ======================================================

function abrirFoto(url) {


    window.open(
        url,
        "_blank"
    );

}



// ======================================================
// FILTROS
// ======================================================

const buscar =
    document.getElementById("buscar");


const fecha =
    document.getElementById("fecha");


const cliente =
    document.getElementById("cliente");


function aplicarFiltros() {


    const texto =
        buscar.value
        .toLowerCase()
        .trim();


    const fechaSeleccionada =
        fecha.value;


    const clienteSeleccionado =
        cliente.value;


    const tarjetas =
        document.querySelectorAll(
            ".colecta"
        );


    let visibles = 0;

    let paquetes = 0;


    tarjetas.forEach(tarjeta => {


        const nombreCliente =
            tarjeta.dataset.busqueda;


        const fechaColecta =
            tarjeta.dataset.fecha;


        const idCliente =
            tarjeta.dataset.cliente;


        const coincideTexto =
            !texto ||
            nombreCliente.includes(texto) ||
            tarjeta.dataset.id.includes(texto);


        const coincideFecha =
            !fechaSeleccionada ||
            fechaColecta === fechaSeleccionada;


        const coincideCliente =
            !clienteSeleccionado ||
            idCliente === clienteSeleccionado;


        const visible =
            coincideTexto &&
            coincideFecha &&
            coincideCliente;


        tarjeta.style.display =
            visible
                ? ""
                : "none";


        if(visible){

            visibles++;

            const cantidad =
                Number(
                    tarjeta.querySelector(
                        ".resumen-item:nth-child(2) strong"
                    )?.textContent
                ) || 0;

            paquetes += cantidad;

        }

    });


    document.getElementById(
        "totalColectas"
    ).textContent = visibles;


    document.getElementById(
        "totalPaquetes"
    ).textContent = paquetes;

}


buscar.addEventListener(
    "input",
    aplicarFiltros
);


fecha.addEventListener(
    "change",
    aplicarFiltros
);


cliente.addEventListener(
    "change",
    aplicarFiltros
);


aplicarFiltros();


</script>


</body>

</html>
