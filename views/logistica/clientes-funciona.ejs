<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Clientes - Logística</title>

<link rel="stylesheet" href="/css/panel.css">


<style>

:root{

    --primary:#2563eb;
    --success:#16a34a;
    --danger:#dc2626;
    --dark:#0f172a;
    --bg:#f1f5f9;
    --card:#ffffff;
    --border:#e2e8f0;
    --text:#334155;
    --shadow:0 10px 25px rgba(15,23,42,.08);

}


*{

    box-sizing:border-box;

}



body{

    margin:0;

    background:var(--bg);

    font-family:
    Inter,
    Arial,
    Helvetica,
    sans-serif;

    color:var(--text);

}



/* HEADER */

.header{

    background:
    linear-gradient(135deg,#0f172a,#2563eb);

    color:white;

    padding:25px;

    box-shadow:var(--shadow);

}


.header h2{

    margin:0;

    font-size:25px;

}


.header p{

    margin:8px 0 0;

    opacity:.8;

}





/* CONTENEDOR */

.container{

    width:100%;

    max-width:1200px;

    margin:auto;

    padding:20px;

}




/* CARDS */

.box{

    background:white;

    border-radius:18px;

    padding:25px;

    margin-bottom:25px;

    box-shadow:var(--shadow);

    border:1px solid var(--border);

}


.box h3{

    margin-top:0;

    color:var(--dark);

}





/* FORMULARIO */

.form-grid{

    display:grid;

    grid-template-columns:1fr;

    gap:14px;

}



input{

    width:100%;

    padding:14px;

    border-radius:12px;

    border:1px solid #cbd5e1;

    font-size:15px;

}



input:focus{

    outline:none;

    border-color:var(--primary);

    box-shadow:0 0 0 3px rgba(37,99,235,.15);

}




.btn-primary{

    background:var(--primary);

    color:white;

    border:none;

    padding:14px;

    border-radius:12px;

    font-size:16px;

    font-weight:bold;

    cursor:pointer;

}





/* TABLA */

.table-container{

    width:100%;

    overflow-x:auto;

}



table{

    width:100%;

    min-width:950px;

    border-collapse:collapse;

}



thead{

    background:#f8fafc;

}



th{

    color:#475569;

    text-align:left;

}



th,
td{

    padding:14px;

    border-bottom:1px solid var(--border);

}



tbody tr:hover{

    background:#f8fafc;

}




/* BOTONES ACCIONES */

.btn-edit,
.btn-delete{

    color:white;

    text-decoration:none;

    padding:8px 12px;

    border-radius:8px;

    font-size:14px;

    display:inline-block;

    margin:2px;

}



.btn-edit{

    background:var(--success);

}



.btn-delete{

    background:var(--danger);

}






/* TABLET */

@media(min-width:768px){


.form-grid{

    grid-template-columns:repeat(2,1fr);

}


.btn-primary{

    grid-column:span 2;

}


}





/* PC */

@media(min-width:1100px){


.container{

    padding:35px;

}


}



</style>


</head>


<body>



<div class="header">


<h2>

👥 Clientes Logística

</h2>


<p>

Usuario: <%= username %>

</p>


</div>






<div class="container">





<div class="box">


<h3>

➕ Nuevo cliente

</h3>




<form 
method="POST"
action="/panel/logistica/clientes"
>


<div class="form-grid">



<input

name="nombre"

placeholder="Nombre del cliente"

required

>




<input

name="empresa"

placeholder="Empresa"

>




<input

name="telefono"

placeholder="Teléfono"

>




<input

name="email"

type="email"

placeholder="Email"

>




<input

name="direccion"

placeholder="Dirección"

>




<button 
class="btn-primary"
type="submit"
>

💾 Guardar cliente

</button>



</div>


</form>



</div>







<div class="box">


<h3>

📋 Clientes registrados

</h3>




<div class="table-container">


<table>



<thead>


<tr>

<th>ID</th>

<th>Nombre</th>

<th>Empresa</th>

<th>Teléfono</th>

<th>Email</th>

<th>Dirección</th>

<th>Acciones</th>

</tr>


</thead>





<tbody>


<% clientes.forEach(cliente => { %>



<tr>



<td>

<%= cliente.id %>

</td>




<td>

<%= cliente.nombre %>

</td>




<td>

<%= cliente.empresa || "-" %>

</td>




<td>

<%= cliente.telefono || "-" %>

</td>




<td>

<%= cliente.email || "-" %>

</td>




<td>

<%= cliente.direccion || "-" %>

</td>





<td>



<a

class="btn-edit"

href="/panel/logistica/clientes/editar/<%= cliente.id %>"

>

✏️ Editar

</a>





<a

class="btn-delete"

href="/panel/logistica/clientes/eliminar/<%= cliente.id %>"

onclick="return confirm('¿Seguro que desea eliminar este cliente?')"

>

🗑️ Borrar

</a>




</td>




</tr>



<% }) %>



</tbody>




</table>


</div>



</div>






</div>





</body>

</html>